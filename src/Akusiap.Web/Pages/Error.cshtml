@page
@model ErrorModel
@{
  ViewData["Title"] = T["Error.Title"].Value;
}

<section class="space-y-3 py-6">
  <h1 class="text-xl font-bold text-red-700">@T["Error.Heading"]</h1>
  <p class="text-slate-600">@T["Error.Body"]</p>
  @if (Model.ShowRequestId)
  {
    <p class="text-sm text-slate-500">@T["Error.RequestId"]: <code>@Model.RequestId</code></p>
  }
</section>
