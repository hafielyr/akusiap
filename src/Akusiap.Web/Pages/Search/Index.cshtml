@page "/cari"
@model Akusiap.Web.Pages.Search.IndexModel
@* Search questions and exams (BRD-04). *@
@{
  ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? T["Search.Title"].Value : $"{Model.Query} · {T["Search.Title"].Value}";
  ViewData["Wide"] = true;
}

<section class="space-y-6">
  <div class="panel space-y-4 px-5 py-7 sm:px-8">
    <h1 class="text-3xl font-bold leading-tight tracking-tight">@T["Search.Title"]</h1>
    <p class="max-w-xl text-slate-600">@T["Search.Lead"]</p>
    <partial name="_SearchBoxPartial" model="(Model.Query, true, false)" />
  </div>

  <partial name="_SearchResultsPartial" model="Model" />
</section>
