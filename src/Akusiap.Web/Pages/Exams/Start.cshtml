@page "/ujian/{id:long}/mulai"
@model Akusiap.Web.Pages.Exams.StartModel
@using Akusiap.Application.Sessions
@using Akusiap.Domain.Sessions
@inject Microsoft.Extensions.Localization.IStringLocalizer<Akusiap.Web.Localization.SharedResource> S
@* Session setup (SES-02). Alpine only shows the fields of the chosen mode; without JavaScript both show and the server
   ignores the Practice fields in Simulation. Compact (BRD-07): modes side by side, count and time on one row, topics as
   chips, switches in a 2-column grid, and "Mulai" stuck to the bottom on phones. *@
@{
  var setup = Model.Setup;
  var preset = setup.Preset;
  ViewData["Title"] = T["Session.Setup.Title"].Value;
  var locked = new List<string>
  {
    preset.TimeLimitMinutes is { } minutes ? S["Admin.Presets.Minutes", minutes] : S["Admin.Presets.Untimed"],
    S["Session.Setup.QuestionCountValue", setup.DefaultQuestionCount],
    S["Session.Setup.NoHints"],
  };
  var noSimulationsLeft = setup.SimulationAttemptsLeft == 0;
}

<section class="mx-auto max-w-2xl space-y-4">
  <div class="space-y-1">
    <a href="@ExamRoutes.Detail(setup.ExamId)" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @setup.Title</a>
    <h1 class="text-2xl font-bold leading-tight">@T["Session.Setup.Title"]</h1>
    @if (setup.IsTrial)
    {
      <p class="rounded-lg bg-brand-50 px-3 py-2 text-sm text-brand-800" data-testid="trial-note">@T["Session.Setup.TrialNote", setup.AvailableCount]</p>
    }
  </div>

  @if (Model.Errors.Count > 0)
  {
    <ul role="alert" class="space-y-1 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-testid="setup-errors">
      @foreach (var error in Model.Errors)
      {
        <li>@error</li>
      }
    </ul>
  }

  <form method="post" class="space-y-4" novalidate
        x-data="{ mode: '@Model.Form.Mode', untimed: @(Model.Form.Untimed ? "true" : "false") }">
    <fieldset class="grid grid-cols-2 gap-2">
      <legend class="label mb-2">@T["Session.Setup.Mode"]</legend>
      @foreach (var mode in new[] { AttemptMode.Practice, AttemptMode.Simulation })
      {
        <label class="card card-link flex min-h-11 cursor-pointer items-start gap-2 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 sm:gap-3 sm:p-4">
          <input type="radio" name="Form.Mode" value="@mode" checked="@(Model.Form.Mode == mode)" x-model="mode" class="mt-0.5 size-5 shrink-0 accent-brand-600" data-testid="mode-@mode" />
          <span>
            <span class="block font-semibold">@T[$"Session.Setup.{mode}"]</span>
            <span class="block text-xs text-slate-600 sm:text-sm">@T[$"Session.Setup.{mode}Hint"]</span>
          </span>
        </label>
      }
    </fieldset>

    <div x-show="mode === 'Practice'" class="space-y-4" data-testid="practice-fields">
      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <label asp-for="Form.QuestionCount" class="label">@T["Session.Setup.QuestionCount", setup.AvailableCount]</label>
          <input asp-for="Form.QuestionCount" type="number" min="1" max="@setup.AvailableCount" inputmode="numeric" class="input" />
        </div>
        <div x-show="!untimed" class="space-y-1">
          <label asp-for="Form.TimeLimitMinutes" class="label">@T["Admin.Preset.TimeLimit"]</label>
          <input asp-for="Form.TimeLimitMinutes" type="number" min="@(preset.TimeLimitMinutes ?? 1)" max="@SessionRulesBuilder.MaxTimeLimitMinutes" inputmode="numeric" class="input" />
        </div>
      </div>
      <span asp-validation-for="Form.QuestionCount" class="field-error"></span>
      @if (preset.TimeLimitMinutes is { } floor)
      {
        <p x-show="!untimed" class="text-sm text-slate-500">@T["Session.Setup.MinTime", floor]</p>
      }
      <span asp-validation-for="Form.TimeLimitMinutes" class="field-error"></span>

      @if (setup.Topics.Count > 1)
      {
        <fieldset class="space-y-2">
          <legend class="label mb-2">@T["Session.Setup.Topics"]</legend>
          <div class="flex flex-wrap gap-2">
            @foreach (var topic in setup.Topics)
            {
              <label class="toggle-chip">
                <input type="checkbox" name="Form.TopicIds" value="@topic.Id" checked="@Model.Form.TopicIds.Contains(topic.Id)" class="size-4 rounded border-slate-300 accent-brand-600" />
                <span>@topic.Name <span class="text-slate-500">· @topic.QuestionCount</span></span>
              </label>
            }
          </div>
          <span asp-validation-for="Form.TopicIds" class="field-error"></span>
        </fieldset>
      }

      <div class="grid grid-cols-2 gap-2">
        <label class="toggle-tile">
          <input asp-for="Form.Untimed" x-model="untimed" class="size-5 shrink-0 rounded border-slate-300 accent-brand-600" />
          <span>@T["Admin.Presets.Untimed"]</span>
        </label>
        <label class="toggle-tile">
          <input asp-for="Form.HintsEnabled" disabled="@(!preset.HintsEnabled)" class="size-5 shrink-0 rounded border-slate-300 accent-brand-600" />
          <span>@T["Session.Setup.Hints"]@if (!preset.HintsEnabled) { <span class="block text-xs text-slate-500">@T["Session.Rules.HintsOff"]</span> }</span>
        </label>
        <label class="toggle-tile">
          <input asp-for="Form.ShuffleQuestions" class="size-5 shrink-0 rounded border-slate-300 accent-brand-600" />
          <span>@T["Admin.Preset.ShuffleQuestions"]</span>
        </label>
        <label class="toggle-tile">
          <input asp-for="Form.ShuffleOptions" class="size-5 shrink-0 rounded border-slate-300 accent-brand-600" />
          <span>@T["Admin.Preset.ShuffleOptions"]</span>
        </label>
      </div>
      <span asp-validation-for="Form.HintsEnabled" class="field-error"></span>
    </div>

    @if (setup.Tryouts.Count > 0)
    {
      @* CPNS-07 (D-142): fixed tryout sets, each different; the first one not finished yet is picked. *@
      var chosen = Model.Form.TryoutSet ?? setup.SuggestedTryout;
      <fieldset x-show="mode === 'Simulation'" class="space-y-2" data-testid="tryout-sets">
        <legend class="label mb-2">@T["Session.Setup.TryoutSet"]</legend>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
          @foreach (var tryout in setup.Tryouts)
          {
            <label class="card card-link flex min-h-11 cursor-pointer items-center gap-2 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
              <input type="radio" name="Form.TryoutSet" value="@tryout.Number" checked="@(chosen == tryout.Number)" class="size-5 shrink-0 accent-brand-600" data-testid="tryout-set" data-number="@tryout.Number" data-done="@(tryout.Done ? "true" : "false")" />
              <span class="font-semibold">@T["Session.Setup.TryoutNumber", tryout.Number]</span>
              @if (tryout.Done)
              {
                <span class="ml-auto text-green-700" title="@T["Session.Setup.TryoutDone"]" aria-label="@T["Session.Setup.TryoutDone"]">✓</span>
              }
            </label>
          }
        </div>
      </fieldset>
    }

    <div x-show="mode === 'Simulation'" class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm" data-testid="simulation-rules">
      <p class="font-semibold">@T["Session.Setup.Locked"]</p>
      <p>@string.Join(" · ", locked)</p>
      @if (setup.SimulationAttemptsLeft is { } left)
      {
        <p class="@(noSimulationsLeft ? "text-red-800" : "text-slate-600")" data-testid="attempts-left">@T["Session.Setup.AttemptsLeft", left]</p>
      }
    </div>

    <div class="sticky-cta">
      <button type="submit" class="btn btn-primary w-full shadow-lg" data-testid="start">@T["Session.Setup.Start"] <span class="arrow" aria-hidden="true">→</span></button>
    </div>
  </form>
</section>
