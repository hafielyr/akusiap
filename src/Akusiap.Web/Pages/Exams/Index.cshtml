@page "/ujian"
@model Akusiap.Web.Pages.Exams.IndexModel
@* Exam catalog (CAT-01, BRD-03). The form is a plain GET (works without JavaScript); htmx swaps only #catalog-results. *@
@{
  ViewData["Title"] = T["Catalog.Title"].Value;
  ViewData["Wide"] = true;
}

<section class="space-y-5">
  <div class="glow space-y-3 px-5 py-7 sm:px-8">
    <span class="eyebrow">@T["Catalog.Eyebrow"]</span>
    <h1 class="text-3xl font-extrabold leading-tight tracking-tight">@T["Catalog.Title"]</h1>
    <p class="max-w-xl text-slate-600">@T["Catalog.Lead"]</p>

    <form method="get" action="/ujian" role="search" class="grid gap-2 pt-2 sm:grid-cols-[1fr_auto]"
          hx-get="/ujian" hx-target="#catalog-results" hx-swap="outerHTML" hx-push-url="true"
          hx-trigger="input changed delay:300ms from:#catalog-q, change from:#catalog-subject, submit">
      <div class="card flex items-center gap-1 rounded-full p-1 pl-4">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0 text-slate-400"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <label for="catalog-q" class="sr-only">@T["Catalog.Search"]</label>
        <input id="catalog-q" name="q" type="search" value="@Model.Search" placeholder="@T["Catalog.Search"]" class="min-h-11 w-full min-w-0 bg-transparent px-2 text-base text-slate-900 outline-none placeholder:text-slate-400" autocomplete="off" />
        <button type="submit" class="btn btn-primary shrink-0 px-4">@T["Catalog.Apply"]</button>
      </div>
      @if (Model.Subjects.Count > 0)
      {
        <label for="catalog-subject" class="sr-only">@T["Catalog.Subject"]</label>
        <select id="catalog-subject" name="subjek" class="input rounded-full">
          <option value="">@T["Catalog.AllSubjects"]</option>
          @foreach (var subject in Model.Subjects)
          {
            <option value="@subject.Id" selected="@(subject.Id == Model.SubjectId)">@subject.Name</option>
          }
        </select>
      }
    </form>
    <a href="/cari" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand-700" data-testid="catalog-search-questions">@T["Catalog.SearchQuestions"] →</a>
  </div>

  <partial name="_CatalogResultsPartial" model="Model" />
</section>
