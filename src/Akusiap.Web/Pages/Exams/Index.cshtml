@page "/ujian"
@model Akusiap.Web.Pages.Exams.IndexModel
@* Exam catalog (CAT-01). The form is a plain GET (works without JavaScript); htmx swaps only #catalog-results. *@
@{
  ViewData["Title"] = T["Catalog.Title"].Value;
}

<section class="space-y-5">
  <div class="space-y-2 rounded-2xl bg-panel p-5 text-white shadow-sm">
    <h1 class="text-2xl font-extrabold leading-tight">@T["Catalog.Title"]</h1>
    <p class="text-brand-100">@T["Catalog.Lead"]</p>
  </div>

  <form method="get" action="/ujian" role="search" class="grid gap-3 sm:grid-cols-[1fr_auto_auto]"
        hx-get="/ujian" hx-target="#catalog-results" hx-swap="outerHTML" hx-push-url="true"
        hx-trigger="input changed delay:300ms from:#catalog-q, change from:#catalog-subject, submit">
    <label for="catalog-q" class="sr-only">@T["Catalog.Search"]</label>
    <div class="relative">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="pointer-events-none absolute top-3 left-3 size-5 text-slate-400"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <input id="catalog-q" name="q" type="search" value="@Model.Search" placeholder="@T["Catalog.Search"]" class="input pl-10" autocomplete="off" />
    </div>
    @if (Model.Subjects.Count > 0)
    {
      <label for="catalog-subject" class="sr-only">@T["Catalog.Subject"]</label>
      <select id="catalog-subject" name="subjek" class="input">
        <option value="">@T["Catalog.AllSubjects"]</option>
        @foreach (var subject in Model.Subjects)
        {
          <option value="@subject.Id" selected="@(subject.Id == Model.SubjectId)">@subject.Name</option>
        }
      </select>
    }
    <button type="submit" class="btn btn-secondary">@T["Catalog.Apply"]</button>
  </form>

  <partial name="_CatalogResultsPartial" model="Model" />
</section>
