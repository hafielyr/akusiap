@model Akusiap.Web.Pages.Exams.IndexModel
@using Akusiap.Application.Catalog
@* Catalog results: total, cards and paging. Returned alone for htmx requests. *@
@{
  var results = Model.Results;
  const int MaxTopics = 3;
}
<div id="catalog-results" class="space-y-3">
  <p class="text-sm text-slate-500" data-testid="catalog-total">@T["Catalog.Total", results.Total]</p>

  @if (results.Items.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600" data-testid="catalog-empty">
      @(Model.IsFiltered ? T["Catalog.NoMatch"] : T["Catalog.Empty"])
    </p>
  }
  else
  {
    <ul class="space-y-3" data-testid="catalog-list">
      @foreach (var item in results.Items)
      {
        <li>
          <a href="/ujian/@item.Id" class="block space-y-2 rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600" data-testid="catalog-card" data-exam-id="@item.Id">
            <span class="flex items-start justify-between gap-3">
              <span class="font-semibold leading-snug">@item.Title</span>
              @switch (item.Badge)
              {
                case CatalogBadge.YourAccess:
                  <span class="shrink-0 rounded-full bg-green-50 px-2 py-1 text-xs font-semibold text-green-800" data-testid="badge">@T["Catalog.YourAccess"]</span>
                  break;
                case CatalogBadge.Free:
                  <span class="shrink-0 rounded-full bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700" data-testid="badge">@T["Catalog.Free"]</span>
                  break;
                default:
                  <span class="shrink-0 rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-800" data-testid="badge"><idr value="@(item.PriceIdr ?? 0)" /></span>
                  break;
              }
            </span>
            @if (item.SubjectName is not null)
            {
              <span class="block text-xs font-medium uppercase tracking-wide text-slate-500">@item.SubjectName</span>
            }
            @if (item.DescriptionExcerpt is not null)
            {
              <span class="block text-sm text-slate-600">@item.DescriptionExcerpt</span>
            }
            <span class="block text-sm text-slate-700">
              @T["Catalog.QuestionCount", item.ActiveQuestionCount]@if (item.Topics.Count > 0)
              {
                <text> · @string.Join(", ", item.Topics.Take(MaxTopics))</text>
                @if (item.Topics.Count > MaxTopics) { <text> @T["Catalog.MoreTopics", item.Topics.Count - MaxTopics]</text> }
              }
            </span>
            <span class="block text-sm text-slate-500">
              @if (item.IsFree)
              {
                @T["Catalog.FreeForMembers"]
              }
              else
              {
                <idr value="@(item.PriceIdr ?? 0)" /> <text>· @T["Catalog.AccessDays", item.AccessDays ?? 0]</text>
              }
            </span>
          </a>
        </li>
      }
    </ul>

    @if (results.PageCount > 1)
    {
      <nav aria-label="@T["Catalog.Pages"]" class="flex items-center justify-between gap-3" data-testid="catalog-pager">
        @if (results.Page > 1)
        {
          <a href="@Model.PageUrl(results.Page - 1)" class="btn btn-secondary" hx-get="@Model.PageUrl(results.Page - 1)" hx-target="#catalog-results" hx-swap="outerHTML" hx-push-url="true">@T["Catalog.Previous"]</a>
        }
        else
        {
          <span></span>
        }
        <span class="text-sm text-slate-600">@T["Catalog.PageOf", results.Page, results.PageCount]</span>
        @if (results.Page < results.PageCount)
        {
          <a href="@Model.PageUrl(results.Page + 1)" class="btn btn-secondary" hx-get="@Model.PageUrl(results.Page + 1)" hx-target="#catalog-results" hx-swap="outerHTML" hx-push-url="true">@T["Catalog.Next"]</a>
        }
        else
        {
          <span></span>
        }
      </nav>
    }
  }
</div>
