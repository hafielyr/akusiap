  <h1 class="text-2xl font-bold leading-tight sm:text-3xl">@T["Home.Heading"]</h1>
  <p class="text-slate-600">@T["Home.Lead"]</p>
  <div class="flex flex-wrap gap-3">
    <a href="/ujian" class="btn btn-primary">@T["Home.BrowseCatalog"]</a>
  </div>
</section>
