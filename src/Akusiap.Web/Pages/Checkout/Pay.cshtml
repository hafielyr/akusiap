@page "/bayar/{orderNumber}"
@model Akusiap.Web.Pages.Checkout.PayModel
@using Akusiap.Application.Payments
@using Akusiap.Domain
@using Akusiap.Domain.Payments
@using Akusiap.Web.Pages.Exams
@inject Microsoft.Extensions.Localization.IStringLocalizer<Akusiap.Web.Localization.SharedResource> S
@* Payment instructions (PAY-05). The Pending view polls the status; everything else is static. *@
@{
  var payment = Model.Payment;
  ViewData["Title"] = T["Pay.Title"].Value;
  var item = payment.DurationMonths is { } months ? $"{payment.ItemTitle} · {S["Admin.Plans.Months", months]}" : payment.ItemTitle;
  var bank = payment.Channel ?? string.Empty;
}

<section class="mx-auto max-w-md space-y-5" data-testid="payment" data-state="@payment.State">
  <div class="space-y-1">
    <h1 class="text-2xl font-bold leading-tight">@T["Pay.Title"]</h1>
    <p class="text-sm text-slate-600">@T["Pay.Order", payment.OrderNumber]</p>
  </div>

  <article class="space-y-1 card p-4">
    <p class="font-semibold">@item</p>
    <p class="text-2xl font-bold" data-testid="pay-amount"><idr value="@payment.AmountIdr" /></p>
  </article>

  @switch (payment.State)
  {
    case PaymentDisplayState.Paid:
      <div class="space-y-3 rounded-xl border border-green-200 bg-green-50 p-4" data-testid="pay-success">
        <p class="font-semibold text-green-900">@T["Pay.Paid"]</p>
        @if (payment.ExamId is { } examId)
        {
          <a href="@ExamRoutes.Start(examId)" class="btn btn-primary w-full">@T["ExamPage.Start"]</a>
        }
        <a href="/learn/akses" class="btn btn-secondary w-full">@T["Learn.Access.Title"]</a>
      </div>
      break;
    case PaymentDisplayState.Expired:
    case PaymentDisplayState.Failed:
      <div class="space-y-3 rounded-xl border border-red-200 bg-red-50 p-4" data-testid="pay-ended">
        <p class="font-semibold text-red-900">@(payment.State == PaymentDisplayState.Expired ? T["Pay.Expired"] : T["Pay.Failed"])</p>
        <a href="@ExamRoutes.Catalog" class="btn btn-secondary w-full">@T["Learn.Access.Browse"]</a>
      </div>
      break;
    default:
      <div x-data="{ left: @(payment.SecondsLeft ?? 0), copied: false, get clock() { const h = Math.floor(this.left / 3600), m = Math.floor(this.left % 3600 / 60), s = this.left % 60; return (h ? h + ':' : '') + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0'); } }"
           x-init="const t = setInterval(() => { if (left > 0) left--; else clearInterval(t); }, 1000)" class="space-y-4">
        <div hx-get="?handler=Status&shown=Pending" hx-trigger="every 5s" hx-swap="none" aria-hidden="true"></div>

        @if (payment.ExpiresAt is { } deadline)
        {
          <p class="rounded-lg bg-slate-900 px-3 py-2 text-center text-slate-50" data-testid="countdown">
            <span x-show="left > 0">@T["Pay.PayWithin"] <span class="font-mono" x-text="clock"></span> · @T["Pay.Until", JakartaTime.Format(deadline)]</span>
            <span x-show="left <= 0" x-cloak data-testid="countdown-expired">@T["Pay.Expired"]</span>
          </p>
        }

        @if (payment.QrString is { } qr)
        {
          <div class="space-y-2 card p-4 text-center" data-testid="pay-qr">
            <p class="font-semibold">@T["Pay.ScanQris"]</p>
            <div class="mx-auto w-60 max-w-full">@Html.Raw(Akusiap.Web.Pages.Checkout.PayModel.QrSvg(qr))</div>
            <p class="text-sm text-slate-600">@T["Pay.QrisHint"]</p>
          </div>
        }

        @if (payment.DeeplinkUrl is { } deeplink)
        {
          @* Card, e-wallets and QRIS continue on DOKU's hosted page (PAY-04, D-110); the fake gateway links a dev page. *@
          var hosted = deeplink.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
          <a href="@deeplink" class="btn btn-primary w-full" data-testid="pay-deeplink">@(hosted ? T["Pay.OpenHosted"] : T["Pay.OpenApp"])</a>
          @if (hosted)
          {
            <p class="text-center text-sm text-slate-600" data-testid="pay-hosted-hint">@T["Pay.HostedHint"]</p>
          }
        }

        @if (payment.VaNumber is { } va)
        {
          <div class="space-y-3 card p-4" data-testid="pay-va">
            <p class="text-sm text-slate-600">@T["Pay.VaNumber", bank]</p>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-xl font-semibold tracking-wider" data-testid="va-number">@va</span>
              <button type="button" class="btn btn-secondary shrink-0" x-on:click="navigator.clipboard.writeText('@va').then(() => { copied = true; setTimeout(() => copied = false, 2000) })">
                <span x-show="!copied">@T["Pay.Copy"]</span><span x-show="copied" x-cloak>@T["Pay.Copied"]</span>
              </button>
            </div>
            @foreach (var way in new[] { "Mobile", "Atm", "Internet" })
            {
              <details class="rounded-lg border border-slate-200 px-3 py-2">
                <summary class="flex min-h-11 cursor-pointer items-center font-medium">@T[$"Pay.Va.{way}", bank]</summary>
                <ol class="list-decimal space-y-1 pb-2 pl-5 text-sm text-slate-700">
                  @for (var step = 1; step <= 4; step++)
                  {
                    <li>@S[$"Pay.Va.{way}.Step{step}", bank, va]</li>
                  }
                </ol>
              </details>
            }
            <p class="text-xs text-slate-500">@T["Pay.Va.General"]</p>
          </div>
        }

        <p class="text-center text-sm text-slate-500">@T["Pay.Waiting"]</p>
      </div>
      break;
  }
</section>
