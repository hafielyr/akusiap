@page "/checkout"
@model Akusiap.Web.Pages.Checkout.IndexModel
@using Akusiap.Domain
@using Akusiap.Domain.Payments
@using Akusiap.Application.Payments
@inject Microsoft.Extensions.Localization.IStringLocalizer<Akusiap.Web.Localization.SharedResource> S
@*
  Checkout (PAY-03, PAY-12, D-113). Phones: a compact summary, payment methods as tiles (QRIS first), and a bar stuck to
  the bottom with the terms checkbox, the total and "Bayar". Wide screens: methods on the left, and the summary with
  terms and "Bayar" in a column on the right that stays in view.
*@
@{
  ViewData["Title"] = T["Checkout.Title"].Value;
  var summary = Model.Summary;
  var groups = Model.Channels.GroupBy(c => c.Method).ToList();
  var title = summary.DurationMonths is { } months ? $"{summary.Title} · {S["Admin.Plans.Months", months]}" : summary.Title;
  var kind = summary.Item.ExamId is not null ? S["Learn.Access.Exam"].Value : S["Learn.Access.Plan"].Value;
  var what = summary.IncludesAllExams ? S["Pricing.PlanHint"].Value : summary.AccessDays is { } days ? S["Checkout.ExamAccess", days].Value : null;
  var until = summary.IsExtension ? S["Checkout.ExtendsTo", JakartaTime.FormatDate(summary.AccessEndsAt)].Value : S["Checkout.AccessTo", JakartaTime.FormatDate(summary.AccessEndsAt)].Value;
  var canPay = summary.PendingOrderNumber is null && Model.EmailConfirmed;
  ViewData["Wide"] = canPay;
  // The group heading already says "Virtual account", so the tile shows the bank.
  static string Short(PaymentChannelSetting channel) =>
    channel.Method == PaymentMethod.VirtualAccount && channel.Label.EndsWith(" Virtual Account", StringComparison.OrdinalIgnoreCase) ? channel.Label[..^" Virtual Account".Length] : channel.Label;
}

<section class="mx-auto space-y-4 @(canPay ? null : "max-w-md")">
  <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h1 class="text-2xl font-extrabold leading-tight sm:text-3xl">@T["Checkout.Title"]</h1>
    <p class="flex items-center gap-1.5 text-sm text-slate-600">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2 text-green-600"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
      @T["Checkout.Secure"]
    </p>
  </div>

  @if (!canPay)
  {
    <partial name="_CheckoutSummaryPartial" model="(summary, title, kind, what, until)" />
    @if (summary.PendingOrderNumber is { } pending)
    {
      <div class="space-y-3 rounded-2xl border border-amber-200 bg-amber-50 p-4" data-testid="pending-payment">
        <p class="text-sm text-amber-900">@T["Checkout.PendingExists", pending]</p>
        <a href="@PaymentRoutes.Instructions(pending)" class="btn btn-primary w-full">@T["Checkout.SeeInstructions"]</a>
      </div>
    }
    else
    {
      <div class="space-y-3 rounded-2xl border border-amber-200 bg-amber-50 p-4" data-testid="confirm-email-first">
        <p class="text-sm text-amber-900">@T["Checkout.ConfirmFirst"]</p>
        <a href="/learn" class="btn btn-secondary w-full">@T["Account.Confirm.Resend"]</a>
      </div>
    }
  }
  else
  {
    @if (Model.Errors.Count > 0)
    {
      <ul role="alert" class="space-y-1 rounded-xl bg-red-50 px-3 py-2 text-sm text-red-800" data-testid="checkout-errors">
        @foreach (var error in Model.Errors)
        {
          <li>@error</li>
        }
      </ul>
    }

    <form method="post" novalidate data-testid="checkout-form" x-data="{ label: $el.dataset.label }" data-label="@(Model.Channels.FirstOrDefault(c => c.Code == Model.Channel)?.Label)"
          class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-6">
      <input type="hidden" name="exam" value="@Model.ExamId" />
      <input type="hidden" name="planPrice" value="@Model.PlanPriceId" />

      @* Phones: summary first (order-1). Wide screens: the right column. *@
      <div class="contents lg:sticky lg:top-20 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:block lg:space-y-4">
        <div class="order-1">
          <partial name="_CheckoutSummaryPartial" model="(summary, title, kind, what, until)" />
        </div>

        <div class="sticky-cta sticky-cta-tall order-3 lg:static">
          <div class="space-y-3 rounded-2xl bg-[var(--surface)] p-3 shadow-[0_-8px_30px_-12px_#0f172a40] ring-1 ring-[var(--line)] sm:p-4 lg:shadow-[var(--shadow)]">
            <label class="flex items-start gap-3 text-sm">
              <input type="checkbox" name="AcceptTerms" value="true" checked="@Model.AcceptTerms" class="mt-0.5 size-5 shrink-0 rounded border-slate-300 accent-brand-600" data-testid="accept-terms" />
              <span>@T["Checkout.Accept"] <a href="@PaymentRoutes.Terms" class="font-medium text-brand-700 underline">@T["Checkout.TermsLink"]</a> &amp; <a href="@PaymentRoutes.RefundPolicy" class="font-medium text-brand-700 underline">@T["Checkout.RefundLink"]</a>.</span>
            </label>
            <div class="flex items-center gap-3">
              <div class="min-w-0 flex-1 lg:hidden">
                <p class="num text-lg font-extrabold leading-tight"><idr value="@summary.PriceIdr" /></p>
                <p class="truncate text-xs text-slate-500" x-text="label || $el.dataset.empty" data-empty="@T["Checkout.ChooseAbove"]">@T["Checkout.ChooseAbove"]</p>
              </div>
              <button type="submit" class="btn btn-primary shrink-0 px-6 lg:w-full" disabled="@(Model.Channels.Count == 0)" data-testid="pay">
                @T["Checkout.Pay"]<span class="hidden lg:inline"> · <idr value="@summary.PriceIdr" /></span> <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <fieldset class="order-2 min-w-0 space-y-4 lg:col-start-1 lg:row-start-1">
        <legend class="mb-3 text-lg font-bold">@T["Checkout.Channel"]</legend>
        @if (Model.Channels.Count == 0)
        {
          <p class="text-slate-600" data-testid="no-channels">@T["Checkout.NoChannels"]</p>
        }
        @foreach (var group in groups)
        {
          <div class="space-y-2">
            <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-500">
              <partial name="_ChannelIconPartial" model="group.Key" />
              @T[$"Checkout.Method.{group.Key}"]
            </p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              @foreach (var channel in group)
              {
                var featured = group.Key == PaymentMethod.QRIS;
                <label class="pay-tile @(featured ? "col-span-2 sm:col-span-3" : null)">
                  <input type="radio" name="Channel" value="@channel.Code" checked="@(Model.Channel == channel.Code)" class="size-5 shrink-0 accent-brand-600"
                         data-testid="channel" data-code="@channel.Code" data-label="@channel.Label" x-on:change="label = $el.dataset.label" />
                  <span class="min-w-0">
                    <span class="block break-words font-semibold leading-tight">@Short(channel)</span>
                    @if (featured)
                    {
                      <span class="block text-xs text-slate-500">@T["Checkout.QrisHint"]</span>
                    }
                  </span>
                  @if (featured)
                  {
                    <span class="chip ml-auto shrink-0">@T["Checkout.Fastest"]</span>
                  }
                </label>
              }
            </div>
          </div>
        }
        <p class="text-sm text-slate-600">@T["Checkout.RefundNote"] <a href="@PaymentRoutes.RefundPolicy" class="font-medium text-brand-700 underline">@T["Checkout.RefundLink"]</a>.</p>
      </fieldset>
    </form>
  }
</section>
