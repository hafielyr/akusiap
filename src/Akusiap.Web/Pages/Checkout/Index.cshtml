@page "/checkout"
@model Akusiap.Web.Pages.Checkout.IndexModel
@using Akusiap.Domain
@using Akusiap.Domain.Payments
@inject Microsoft.Extensions.Localization.IStringLocalizer<Akusiap.Web.Localization.SharedResource> S
@* Checkout (PAY-03). Channels are grouped: QRIS, then virtual accounts, then e-wallets. *@
@{
  ViewData["Title"] = T["Checkout.Title"].Value;
  var summary = Model.Summary;
  var groups = Model.Channels.GroupBy(c => c.Method).ToList();
  var title = summary.DurationMonths is { } months ? $"{summary.Title} · {S["Admin.Plans.Months", months]}" : summary.Title;
}

<section class="mx-auto max-w-md space-y-5">
  <h1 class="text-2xl font-bold leading-tight">@T["Checkout.Title"]</h1>

  <article class="space-y-2 card p-4" data-testid="checkout-summary">
    <p class="text-sm text-slate-500">@(summary.Item.ExamId is not null ? T["Learn.Access.Exam"] : T["Learn.Access.Plan"])</p>
    <p class="text-lg font-semibold">@title</p>
    <p class="text-sm text-slate-700">@(summary.IncludesAllExams ? T["Pricing.PlanHint"] : summary.AccessDays is { } days ? T["Checkout.ExamAccess", days] : null)</p>
    <p class="text-sm text-slate-700" data-testid="access-end">
      @(summary.IsExtension ? T["Checkout.ExtendsTo", JakartaTime.FormatDate(summary.AccessEndsAt)] : T["Checkout.AccessTo", JakartaTime.FormatDate(summary.AccessEndsAt)])
    </p>
    <div class="flex items-baseline justify-between border-t border-slate-200 pt-2">
      <span class="text-sm text-slate-600">@T["Checkout.Total"]</span>
      <span class="text-2xl font-bold" data-testid="checkout-price"><idr value="@summary.PriceIdr" /></span>
    </div>
    <p class="text-xs text-slate-500">@T["Checkout.TaxIncluded"]</p>
  </article>

  @if (summary.PendingOrderNumber is { } pending)
  {
    <div class="space-y-3 rounded-xl border border-amber-200 bg-amber-50 p-4" data-testid="pending-payment">
      <p class="text-sm text-amber-900">@T["Checkout.PendingExists", pending]</p>
      <a href="@PaymentRoutes.Instructions(pending)" class="btn btn-primary w-full">@T["Checkout.SeeInstructions"]</a>
    </div>
  }
  else if (!Model.EmailConfirmed)
  {
    <div class="space-y-3 rounded-xl border border-amber-200 bg-amber-50 p-4" data-testid="confirm-email-first">
      <p class="text-sm text-amber-900">@T["Checkout.ConfirmFirst"]</p>
      <a href="/learn" class="btn btn-secondary w-full">@T["Account.Confirm.Resend"]</a>
    </div>
  }
  else
  {
    @if (Model.Errors.Count > 0)
    {
      <ul role="alert" class="space-y-1 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-testid="checkout-errors">
        @foreach (var error in Model.Errors)
        {
          <li>@error</li>
        }
      </ul>
    }

    <form method="post" class="space-y-5" novalidate data-testid="checkout-form">
      <input type="hidden" name="exam" value="@Model.ExamId" />
      <input type="hidden" name="planPrice" value="@Model.PlanPriceId" />

      @if (Model.Channels.Count == 0)
      {
        <p class="text-slate-600" data-testid="no-channels">@T["Checkout.NoChannels"]</p>
      }
      else
      {
        <fieldset class="space-y-4">
          <legend class="label">@T["Checkout.Channel"]</legend>
          @foreach (var group in groups)
          {
            <div class="space-y-2">
              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">@T[$"Checkout.Method.{group.Key}"]</p>
              @foreach (var channel in group)
              {
                <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
                  <input type="radio" name="Channel" value="@channel.Code" checked="@(Model.Channel == channel.Code)" class="size-5 accent-brand-600" data-testid="channel" data-code="@channel.Code" />
                  <span>@channel.Label</span>
                </label>
              }
            </div>
          }
        </fieldset>
      }

      <div class="space-y-2 card p-4 text-sm">
        <p class="text-slate-600">@T["Checkout.RefundNote"] <a href="@PaymentRoutes.RefundPolicy" class="font-medium text-brand-700 underline">@T["Checkout.RefundLink"]</a></p>
        <label class="flex min-h-11 items-start gap-3">
          <input type="checkbox" name="AcceptTerms" value="true" checked="@Model.AcceptTerms" class="mt-0.5 size-5 shrink-0 rounded border-slate-300 accent-brand-600" data-testid="accept-terms" />
          <span>@T["Checkout.Accept"] <a href="@PaymentRoutes.Terms" class="font-medium text-brand-700 underline">@T["Checkout.TermsLink"]</a> &amp; <a href="@PaymentRoutes.RefundPolicy" class="font-medium text-brand-700 underline">@T["Checkout.RefundLink"]</a>.</span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary w-full" disabled="@(Model.Channels.Count == 0)" data-testid="pay">@T["Checkout.Pay"] · <idr value="@summary.PriceIdr" /></button>
    </form>
  }
</section>
