@model Akusiap.Domain.Payments.PaymentMethod
@using Akusiap.Domain.Payments
@* A small line icon for a payment method group on checkout (PAY-12). *@
<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2">
  @switch (Model)
  {
    case PaymentMethod.QRIS:
      <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 18h2v2h-2zM14 18h2M18 14h2" />
      break;
    case PaymentMethod.VirtualAccount:
      <path d="M3 10 12 4l9 6M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18" />
      break;
    case PaymentMethod.EWallet:
      <path d="M4 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 7l11-3v3M16 13h1" />
      break;
    default:
      <path d="M3 6h18v12H3zM3 10h18M7 15h3" />
      break;
  }
</svg>
