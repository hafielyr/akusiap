@model Akusiap.Application.Sessions.AttemptResult
@using Akusiap.Web.Identity
@* GST-02 (D-135): a guest's one trial is done. The score, topics and weakest topic are above; this card shows what a free
   account adds (locked) and sends them to register, landing on their analysis with this attempt carried over. *@
@{
  const string Analysis = "/learn/analisis";
  var wrong = Model.TotalCount - Model.CorrectCount;
  const string lockIcon = "M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z";
}
<article class="space-y-3 rounded-xl border-2 border-brand-600 bg-white p-4" data-testid="guest-trial-invite">
  <p class="eyebrow">@T["GuestTrial.Eyebrow"]</p>
  <h2 class="text-lg font-bold leading-snug">@T["GuestTrial.Title"]</h2>
  <p class="text-sm text-slate-700">@T["GuestTrial.Lead"]</p>
  <ul class="space-y-2 text-sm text-slate-700" data-testid="guest-trial-locked">
    @foreach (var line in new[]
    {
      T["GuestTrial.Analysis"],
      wrong > 0 ? T["GuestTrial.Cards", wrong] : null,
      T["GuestTrial.Plan"],
      T["GuestTrial.MoreExams"],
    }.Where(l => l is not null))
    {
      <li class="flex items-start gap-2">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-700"><path d="@lockIcon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>@line</span>
      </li>
    }
  </ul>
  <a href="@AccountRoutes.WithReturnUrl(AccountRoutes.Register, Analysis)" class="btn btn-primary w-full" data-testid="guest-trial-register">@T["GuestTrial.Register"]</a>
  <p class="text-center text-sm text-slate-600">
    @T["Account.Register.HaveAccount"]
    <a href="@AccountRoutes.WithReturnUrl(AccountRoutes.SignIn, Analysis)" class="inline-flex min-h-11 items-center font-semibold text-brand-700" data-testid="guest-trial-signin">@T["Nav.SignIn"]</a>
  </p>
</article>
