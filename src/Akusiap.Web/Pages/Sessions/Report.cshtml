@page "/sesi/{id:long}/lapor/{position:int}"
@model Akusiap.Web.Pages.Sessions.ReportModel
@using Akusiap.Application.Moderation
@* "Laporkan soal" (SES-11). *@
@{
  ViewData["Title"] = T["Report.Title"].Value;
  var modelState = ViewContext.ViewData.ModelState;
  string? ErrorFor(string field) => modelState[field]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<section class="mx-auto max-w-xl space-y-4">
  <a href="@Model.BackUrl" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Report.Back"]</a>
  <h1 class="text-2xl font-bold leading-tight">@T["Report.Title"]</h1>
  <blockquote class="line-clamp-4 whitespace-pre-line card p-4 text-sm text-slate-700">@Model.Target.QuestionText</blockquote>

  @if (Model.Sent)
  {
    <div role="status" class="space-y-3 rounded-xl border border-green-200 bg-green-50 p-4 text-green-900" data-testid="report-sent">
      <p>@T["Report.Thanks"]</p>
      <a href="@Model.BackUrl" class="btn btn-secondary">@T["Report.Back"]</a>
    </div>
  }
  else
  {
    <form method="post" class="space-y-4" novalidate data-testid="report-form">
      <fieldset class="space-y-1">
        <legend class="label">@T["Report.Reason"]</legend>
        @foreach (var reason in Enum.GetValues<ReportReason>())
        {
          <label class="flex min-h-11 items-center gap-3 text-slate-800">
            <input type="radio" name="Reason" value="@reason" class="size-5 accent-brand-600" checked="@(Model.Reason == reason)" />
            <span>@T[$"Report.Reason.{reason}"]</span>
          </label>
        }
        @if (ErrorFor("Reason") is { } reasonError) { <span class="field-error" data-testid="error-reason">@reasonError</span> }
      </fieldset>
      <div class="space-y-1">
        <label for="Details" class="label">@T["Report.Details"]</label>
        <textarea id="Details" name="Details" rows="4" maxlength="1000" class="input" placeholder="@T["Report.DetailsHint"]">@Model.Details</textarea>
        @if (ErrorFor("Details") is { } detailsError) { <span class="field-error">@detailsError</span> }
      </div>
      <button type="submit" class="btn btn-primary w-full sm:w-auto">@T["Report.Send"]</button>
    </form>
  }
</section>
