@page "/sesi/{id:long}/hasil"
@model Akusiap.Web.Pages.Sessions.ResultModel
@using Akusiap.Domain.Sessions
@using Akusiap.Web.Identity
@using Akusiap.Web.Pages.Exams
@inject Microsoft.Extensions.Localization.IStringLocalizer<Akusiap.Web.Localization.SharedResource> S
@* Result page (SES-07). The trial offer appears only for Source Trial. *@
@{
  var r = Model.Result;
  ViewData["Title"] = T["Session.Result.Title"].Value;
  var minutes = r.TimeSpentSeconds / 60;
  var seconds = r.TimeSpentSeconds % 60;
  var signedIn = User.Identity?.IsAuthenticated == true;
  // GST-02: a guest's trial result asks them to register; retaking would be a second trial, so it is left out.
  var guestTrial = !signedIn && r.Source == AttemptSource.Trial;
  string ForViewer(string url) => signedIn ? url : AccountRoutes.WithReturnUrl(AccountRoutes.SignIn, url);
}

<section class="mx-auto max-w-xl space-y-5">
  <div class="space-y-1">
    <p class="text-sm text-slate-600">@(!string.IsNullOrEmpty(r.Title) ? r.Title : r.Source == AttemptSource.DailyDrill ? T["Drill.Title"].Value : T["History.Mixed"].Value)</p>
    <h1 class="text-3xl font-bold leading-tight tracking-tight">@T["Session.Result.Title"]</h1>
  </div>

  @if (TempData["Flash"] is string flash)
  {
    <p role="status" class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" data-testid="flash">@T[flash]</p>
  }

  @{
    var ringColor = r.Passed switch { true => "var(--color-green-600)", false => "var(--color-red-600)", _ => "var(--color-brand-600)" };
  }
  <article class="panel rise flex flex-col items-center gap-2 p-6 text-center" data-testid="result-score">
    <span class="dial size-36" style="--p: @((int)Math.Round(r.ScorePercent)); --ring: @ringColor"><span><span class="num text-4xl font-bold tracking-tight">@r.ScorePercent.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)%</span></span></span>
    <p class="text-slate-700">@T["Session.Result.Correct", r.CorrectCount, r.TotalCount]</p>
    @if (r.Passed is { } passed)
    {
      <p class="font-semibold @(passed ? "text-green-700" : "text-red-700")" data-testid="result-passed">@(passed ? T["Session.Result.Passed", r.PassMarkPercent ?? 0] : T["Session.Result.Failed", r.PassMarkPercent ?? 0])</p>
    }
    <p class="text-sm text-slate-600">@T["Session.Result.Time", minutes, seconds]@(r.Status == AttemptStatus.Expired ? " · " + T["Session.Result.Expired"].Value : null)</p>
  </article>

  @if (r.Skd is { } skd)
  {
    @* SKD score (CPNS-03): each subtest against its passing grade. A full 110-question tryout passes or fails; a shorter
       set shows the score scaled to a full subtest, so learners see how far they are from the passing grade. *@
    <section class="panel space-y-4 p-5" aria-labelledby="skd-heading" data-testid="skd-score">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="skd-heading" class="text-lg font-semibold">@T["Skd.Title"]</h2>
        @if (skd.IsFullTest)
        {
          <p class="text-2xl font-bold tabular-nums" data-testid="skd-total">@skd.Total<span class="text-base font-semibold text-slate-500"> / @skd.MaxTotal</span></p>
        }
      </div>
      @if (skd.Passed is { } skdPassed)
      {
        <p class="font-semibold @(skdPassed ? "text-green-700" : "text-red-700")" data-testid="skd-passed">@(skdPassed ? T["Skd.Passed"] : T["Skd.Failed"])</p>
      }
      else
      {
        <p class="text-sm text-slate-600">@T["Skd.PartialNote"]</p>
      }
      <ul class="space-y-3">
        @foreach (var sub in skd.Subtests.Where(s => s.Questions > 0))
        {
          var shown = skd.IsFullTest ? sub.Score : sub.Projected;
          var reached = skd.IsFullTest ? sub.Score >= sub.Rule.PassingGrade : sub.ReachesPassingGrade;
          var width = Math.Clamp(100 * shown / sub.Rule.MaxScore, 0, 100);
          var mark = 100 * sub.Rule.PassingGrade / sub.Rule.MaxScore;
          <li class="space-y-1" data-testid="skd-subtest" data-subtest="@sub.Rule.Code">
            <p class="flex flex-wrap items-baseline justify-between gap-x-3 text-sm">
              <span class="font-semibold text-slate-900">@sub.Rule.Code <span class="font-normal text-slate-600">· @T["Skd.CorrectOf", sub.Correct, sub.Questions]</span></span>
              <span class="tabular-nums"><span class="font-bold @(reached ? "text-green-700" : "text-red-700")" data-testid="skd-subtest-score">@shown</span> / @sub.Rule.MaxScore · @T["Skd.PassingGrade", sub.Rule.PassingGrade]</span>
            </p>
            <div class="relative h-3 rounded-full bg-slate-200" role="img" aria-label="@S["Skd.BarLabel", sub.Rule.Code, shown, sub.Rule.PassingGrade]">
              <div class="h-3 rounded-full @(reached ? "bg-green-600" : "bg-red-600")" style="width: @(width)%"></div>
              <div class="absolute -top-1 h-5 w-0.5 bg-slate-900" style="left: @(mark)%"></div>
            </div>
            @if (!reached)
            {
              <p class="text-sm text-slate-700">@T["Skd.Gap", skd.IsFullTest ? sub.Rule.PassingGrade - sub.Score : sub.Gap]</p>
            }
          </li>
        }
      </ul>
      <p class="text-xs text-slate-500">@T["Skd.RulesNote"]</p>
    </section>
  }

  @if (r.Analysis is { } analysis && r.TotalCount > 0)
  {
    @* Session analysis (CPNS-05): what to do next, from this session's answers. *@
    <section class="card space-y-3 p-4" aria-labelledby="analysis-heading" data-testid="analysis">
      <h2 id="analysis-heading" class="text-lg font-semibold">@T["Analysis.Title"]</h2>
      <ul class="space-y-2 text-sm text-slate-700">
        @if (analysis.WeakestTopic is { } weak)
        {
          <li data-testid="analysis-weakest">@T["Analysis.Weakest", weak.Topic, weak.Correct, weak.Total]</li>
        }
        else
        {
          <li data-testid="analysis-strong">@T["Analysis.AllGood"]</li>
        }
        @if (analysis.SecondsPerQuestion is { } pace)
        {
          <li data-testid="analysis-pace">
            @if (analysis.TargetSecondsPerQuestion is { } target)
            {
              @(pace > target ? T["Analysis.PaceSlow", pace, target] : T["Analysis.PaceOk", pace, target])
            }
            else
            {
              @T["Analysis.Pace", pace]
            }
          </li>
        }
        @if (analysis.CardsQueued > 0)
        {
          <li data-testid="analysis-cards">@T["Analysis.Cards", analysis.CardsQueued]</li>
        }
      </ul>
      <div class="grid gap-2 sm:grid-cols-2">
        @if (analysis.WeakestTopic is { TopicId: > 0 } weakTopic && r.ExamId is { } weakExam)
        {
          <a href="@ExamRoutes.Start(weakExam)?topik=@weakTopic.TopicId" class="btn btn-secondary w-full" data-testid="analysis-practice">@T["Analysis.PracticeTopic", weakTopic.Topic]</a>
        }
        @if (analysis.CardsQueued > 0 && signedIn)
        {
          <a href="/learn/kartu" class="btn btn-secondary w-full" data-testid="analysis-open-cards">@T["Analysis.OpenCards"]</a>
        }
      </div>
    </section>
  }

  @if (Model.Standing is { } standing)
  {
    var boardUrl = standing.ClassroomId is { } classId && standing.ClassAssignmentId is { } assignmentId
      ? Akusiap.Web.Areas.Learn.Pages.Classes.ClassRoutes.Assignment(classId, assignmentId)
      : $"/ujian/{standing.ExamId}/peringkat";
    <a href="@boardUrl" class="card card-link flex items-center gap-4 p-4" data-testid="result-rank">
      <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border-4 border-accent-400 text-lg font-bold text-brand-800">#@standing.Rank</span>
      <span class="space-y-0.5"><span class="block font-bold">@T[standing.Weekly ? "Leaderboard.YouRankWeek" : "Leaderboard.YouRank", standing.Rank, standing.Total]</span><span class="block text-sm text-brand-700">@T["Leaderboard.See"]</span></span>
    </a>
  }

  @if (guestTrial)
  {
    <partial name="_GuestTrialInvitePartial" model="r" />
  }

  @if (r.Offer is { } offer)
  {
    <article class="space-y-3 rounded-xl border border-brand-200 bg-brand-50 p-4" data-testid="trial-offer">
      <p class="font-semibold text-brand-900">@T["Session.Result.TrialDone"]</p>
      <a href="@ForViewer(ExamRoutes.Checkout(offer.ExamId))" class="btn btn-primary w-full" data-testid="offer-buy">@T["Session.Result.BuyExam"] · <idr value="@offer.ExamPriceIdr" /></a>
      <a href="@ExamRoutes.PlansFor(offer.ExamId)" class="btn btn-secondary w-full" data-testid="offer-subscribe">
        @T["ExamPage.Subscribe"]@if (offer.CheapestMonthlyIdr is { } monthly) {<text> · @T["Pricing.From"] <idr value="@monthly" />/@S["Session.Result.Month"]</text>}
      </a>
    </article>
  }

  @if (r.Topics.Count > 0)
  {
    <section class="space-y-2" aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="text-lg font-semibold">@T["Session.Result.ByTopic"]</h2>
      <table class="w-full rounded-xl border border-slate-200 bg-white text-sm" data-testid="topic-table">
        <thead class="text-left text-slate-500">
          <tr><th class="px-3 py-2 font-medium">@T["ExamPage.Topics"]</th><th class="px-3 py-2 text-right font-medium">@T["Session.Result.CorrectShort"]</th><th class="px-3 py-2 text-right font-medium">%</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          @foreach (var topic in r.Topics)
          {
            <tr data-testid="topic-row"><td class="px-3 py-2">@topic.Topic</td><td class="px-3 py-2 text-right" data-testid="topic-score">@topic.Correct/@topic.Total</td><td class="px-3 py-2 text-right">@topic.Percent.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture)</td></tr>
          }
        </tbody>
      </table>
    </section>
  }

  @if (r.Source == AttemptSource.Shared)
  {
    <partial name="_RegisterInvitePartial" model="r.AttemptId" />
  }

  <a href="@SessionRoutes.Review(r.AttemptId)" class="btn btn-primary w-full" data-testid="see-review">@T["Session.Result.SeeReview"]</a>
  <partial name="_RetakeWrongPartial" model="(r.AttemptId, r.ExamId is null || !signedIn ? 0 : r.TotalCount - r.CorrectCount)" />

  @if (r.ExamId is { } examId)
  {
    <a href="@ExamRoutes.Detail(examId)" class="btn btn-secondary w-full">@T["Session.Player.BackToExam"]</a>
  }
</section>
