@inject IOptions<SupportOptions> Support
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1d5fd1" />
  <title>@(ViewData["Title"] is string title ? $"{title} · Akusiap" : "Akusiap")</title>
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
  <script src="~/lib/htmx/htmx.min.js" asp-append-version="true" defer></script>
  <script src="~/lib/alpinejs/alpine.min.js" asp-append-version="true" defer></script>
  @await RenderSectionAsync("Head", required: false)
</head>
<body class="flex min-h-dvh flex-col bg-slate-50 font-sans text-slate-900 antialiased">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
      <a asp-page="/Index" class="text-lg font-bold text-brand-700">Akusiap</a>
      <nav class="flex items-center gap-4 text-sm font-medium text-slate-700">
        @await RenderSectionAsync("Nav", required: false)
      </nav>
    </div>
  </header>

  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-6">
    @RenderBody()
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-4 text-sm text-slate-500">
      &copy; @DateTime.UtcNow.Year Akusiap
    </div>
  </footer>

  @if (!string.IsNullOrWhiteSpace(Support.Value.WhatsAppNumber))
  {
    <a href="@Support.Value.WhatsAppUrl" target="_blank" rel="noopener" data-testid="whatsapp-support"
       class="fixed right-4 bottom-4 flex min-h-12 items-center gap-2 rounded-full bg-green-600 px-4 text-sm font-semibold text-white shadow-lg hover:bg-green-700">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3 1 2.6 1.1 2.8.1.2 1.9 3 4.7 4.2 1.7.7 2.4.8 3.3.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>
      <span>Bantuan</span>
    </a>
  }

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
