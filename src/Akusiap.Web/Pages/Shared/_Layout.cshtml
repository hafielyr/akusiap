@using System.Globalization
@inject IOptions<SupportOptions> Support
@* Site shell (BRD-01): sticky white header with the logo, page content, and a footer with links and the language switcher.
   Pages that draw their own full-width sections (the home page) set ViewData["FullWidth"] = true. *@
@{
  var currentCulture = CultureInfo.CurrentUICulture;
  var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
  var fullWidth = ViewData["FullWidth"] is true;
  // Focused screens (the quiz player) skip the footer, like an exam screen.
  var focus = ViewData["Focus"] is true;
  // The CAT tryout screen (TRY-01) is full screen: no site header either.
  var cat = ViewData["Cat"] is true;
  var path = Context.Request.Path;
}
<!DOCTYPE html>
<html lang="@currentCulture.TwoLetterISOLanguageName">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1f6feb" />
  <title>@(ViewData["Title"] is string title ? $"{title} · {Brand.Name}" : Brand.Name)</title>
  @if (ViewData["NoIndex"] is true)
  {
    <meta name="robots" content="noindex" />
  }
  <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
  @if (ViewData["NoHtmx"] is not true)
  {
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true" defer></script>
  }
  <script src="~/lib/alpinejs/alpine.min.js" asp-append-version="true" defer></script>
  @await RenderSectionAsync("Head", required: false)
</head>
<body class="flex min-h-dvh flex-col bg-slate-50 font-sans text-slate-900 antialiased">
  @if (!cat)
  {
  <header class="sticky top-0 z-30 border-b border-slate-200 bg-white shadow-sm">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-3 px-4">
      <a asp-page="/Index" aria-label="@Brand.Name" class="shrink-0"><partial name="_LogoPartial" /></a>
      <nav class="flex items-center gap-3 text-sm font-semibold text-slate-700">
        <a href="/ujian" class="hidden min-h-11 items-center px-1 hover:text-brand-700 sm:inline-flex @(path.StartsWithSegments("/ujian") ? "text-brand-700" : null)">@T["Nav.Catalog"]</a>
        <a href="/harga" class="hidden min-h-11 items-center px-1 hover:text-brand-700 sm:inline-flex @(path.StartsWithSegments("/harga") ? "text-brand-700" : null)">@T["Nav.Pricing"]</a>
        @await RenderSectionAsync("Nav", required: false)
        <partial name="_AuthNavPartial" />
      </nav>
    </div>
  </header>
  }

  <main id="main" class="@(fullWidth || cat ? "w-full flex-1" : "mx-auto w-full max-w-3xl flex-1 px-4 py-6")">
    @RenderBody()
  </main>

  @if (!focus)
  {
  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 pt-8 pb-24 text-sm text-slate-600 sm:grid-cols-3">
      <div class="space-y-3">
        <partial name="_LogoPartial" />
        <p class="max-w-sm">@T["Footer.Tagline"]</p>
      </div>
      <nav aria-label="@T["Footer.Explore"]" class="flex flex-col gap-1">
        <p class="font-semibold text-slate-900">@T["Footer.Explore"]</p>
        <a href="/ujian" class="py-1 hover:text-brand-700">@T["Nav.Catalog"]</a>
        <a href="/harga" class="py-1 hover:text-brand-700">@T["Nav.Pricing"]</a>
        @if (!string.IsNullOrWhiteSpace(Support.Value.WhatsAppNumber))
        {
          <a href="@Support.Value.WhatsAppUrl" target="_blank" rel="noopener" class="py-1 hover:text-brand-700">@T["Layout.Help"]</a>
        }
      </nav>
      <div class="flex flex-col gap-1">
        <p class="font-semibold text-slate-900">@T["Layout.Language"]</p>
        <nav aria-label="@T["Layout.Language"]" class="flex flex-wrap gap-1" data-testid="language-switcher">
          @foreach (var (code, label) in LocalizationSetup.Languages)
          {
            var isCurrent = string.Equals(currentCulture.Name, code, StringComparison.OrdinalIgnoreCase);
            <a asp-page="/Language" asp-route-culture="@code" asp-route-returnUrl="@returnUrl" hreflang="@code"
               aria-current="@(isCurrent ? "true" : null)"
               class="inline-flex min-h-11 items-center rounded-lg px-3 @(isCurrent ? "bg-brand-50 font-semibold text-brand-700" : "hover:text-slate-900")">@label</a>
          }
        </nav>
      </div>
      <p class="text-xs text-slate-500 sm:col-span-3">&copy; @DateTime.UtcNow.Year @Brand.Name · @Brand.Domain</p>
    </div>
  </footer>
  }

  @if (!string.IsNullOrWhiteSpace(Support.Value.WhatsAppNumber))
  {
    <a href="@Support.Value.WhatsAppUrl" target="_blank" rel="noopener" data-testid="whatsapp-support"
       class="fixed right-4 bottom-4 z-40 flex min-h-12 items-center gap-2 rounded-full bg-green-600 px-4 text-sm font-semibold text-white shadow-lg hover:bg-green-700">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3 1 2.6 1.1 2.8.1.2 1.9 3 4.7 4.2 1.7.7 2.4.8 3.3.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>
      <span>@T["Layout.Help"]</span>
    </a>
  }

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
