@* Light/dark switch (BRD-03, D-103): flips data-theme on <html> and remembers the choice in this browser. *@
<button type="button" class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        x-data="{ dark: document.documentElement.dataset.theme === 'dark' }"
        x-on:click="dark = !dark; document.documentElement.dataset.theme = dark ? 'dark' : 'light'; try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch (e) {}"
        :aria-pressed="dark.toString()" aria-pressed="false" aria-label="@T["Theme.Toggle"]" title="@T["Theme.Toggle"]" data-testid="theme-toggle">
  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" x-show="!dark"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" x-show="dark" x-cloak><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
</button>
