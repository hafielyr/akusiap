@model Akusiap.Application.Gamification.LeaderboardView
@* Leaderboard table (GAM-01): rank, name, score and time; the viewer's own row is highlighted, and shown below the
   top list when they are further down. *@
@{
  string Time(int seconds) => $"{seconds / 60}:{seconds % 60:00}";
  var viewerInTop = Model.Viewer is not null && Model.Top.Any(l => l.IsViewer);
}
@if (Model.Total == 0)
{
  <p class="card border-dashed p-6 text-center text-slate-600" data-testid="leaderboard-empty">@T["Leaderboard.Empty"]</p>
}
else
{
  <div class="card overflow-x-auto">
    <table class="w-full text-sm" data-testid="leaderboard">
      <thead>
        <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
          <th class="px-3 py-2">#</th>
          <th class="px-3 py-2">@T["Leaderboard.Name"]</th>
          <th class="px-3 py-2 text-right">@T["Leaderboard.Score"]</th>
          <th class="px-3 py-2 text-right">@T["Leaderboard.Time"]</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var line in Model.Top)
        {
          <tr class="border-b border-slate-200 @(line.IsViewer ? "bg-brand-50 font-semibold" : null)" data-testid="leaderboard-row" data-rank="@line.Rank" data-viewer="@(line.IsViewer ? "true" : "false")">
            <td class="px-3 py-2">
              @if (line.Rank <= 3)
              {
                <span class="inline-flex size-8 items-center justify-center rounded-full font-bold @(line.Rank == 1 ? "bg-accent-400 text-slate-900" : "bg-brand-100 text-brand-800")">@line.Rank</span>
              }
              else
              {
                <span class="inline-flex size-8 items-center justify-center">@line.Rank</span>
              }
            </td>
            <td class="px-3 py-2" data-testid="leaderboard-name">@line.Name</td>
            <td class="px-3 py-2 text-right num">@line.ScorePercent.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)%</td>
            <td class="px-3 py-2 text-right num">@Time(line.TimeSpentSeconds)</td>
          </tr>
        }
        @if (Model.Viewer is { } me && !viewerInTop)
        {
          <tr><td colspan="4" class="px-3 py-1 text-center text-slate-400">…</td></tr>
          <tr class="bg-brand-50 font-semibold" data-testid="leaderboard-row" data-rank="@me.Rank" data-viewer="true">
            <td class="px-3 py-2"><span class="inline-flex size-8 items-center justify-center">@me.Rank</span></td>
            <td class="px-3 py-2" data-testid="leaderboard-name">@me.Name</td>
            <td class="px-3 py-2 text-right num">@me.ScorePercent.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)%</td>
            <td class="px-3 py-2 text-right num">@Time(me.TimeSpentSeconds)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  <p class="text-xs text-slate-500">@T["Leaderboard.Rule", Model.Total]</p>
}
