@using Akusiap.Infrastructure.Identity
@using Akusiap.Web.Identity
@* Header account links: sign in / sign up for guests, name (linking to the learn area) and sign out for signed-in users. *@
@if (User.Identity?.IsAuthenticated == true)
{
  var isAdmin = User.IsInRole(Akusiap.Domain.Users.RoleNames.Admin);
  @* At 360px there is room for the name or the Admin link, not both: admins see the name from the sm breakpoint. *@
  <a href="/learn" class="max-w-24 truncate py-3 sm:max-w-32 text-slate-700 hover:text-slate-900 @(isAdmin ? "hidden sm:inline-block" : "inline-block")" data-testid="signed-in-name">@User.FindFirst(AppClaimTypes.DisplayName)?.Value</a>
  @if (isAdmin)
  {
    <a href="/admin" class="inline-flex min-h-11 items-center px-1 font-semibold text-brand-700" data-testid="admin-link">@T["Nav.Admin"]</a>
  }
  <form method="post" action="@AccountRoutes.SignOut">
    @Html.AntiForgeryToken()
    <button type="submit" class="inline-flex min-h-11 items-center px-1 text-slate-700 hover:text-slate-900">@T["Nav.SignOut"]</button>
  </form>
}
else
{
  <a href="@AccountRoutes.SignIn" class="inline-flex min-h-11 items-center px-1 hover:text-slate-900">@T["Nav.SignIn"]</a>
  <a href="@AccountRoutes.Register" class="btn btn-primary min-h-11 px-3 py-1.5 text-sm">@T["Nav.Register"]</a>
}
