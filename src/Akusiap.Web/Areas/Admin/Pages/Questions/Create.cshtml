@page "/admin/soal/baru"
@model Akusiap.Web.Areas.Admin.Pages.Questions.CreateModel
@{
  ViewData["Title"] = T["Admin.Questions.NewTitle"].Value;
}

<section class="max-w-2xl space-y-4">
  <a href="/admin/soal" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">← @T["Admin.Questions.Title"]</a>
  <h1 class="text-2xl font-bold leading-tight">@T["Admin.Questions.NewTitle"]</h1>
  <partial name="_QuestionFormPartial" model="new Akusiap.Web.Areas.Admin.Pages.Questions.QuestionFormView(Model.Input, Model.Topics, IsNew: true)" />
</section>
