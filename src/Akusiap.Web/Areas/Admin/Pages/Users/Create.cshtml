@page "/admin/pengguna/baru"
@model Akusiap.Web.Areas.Admin.Pages.Users.CreateModel
@using Akusiap.Domain.Users
@{
  ViewData["Title"] = T["Admin.Users.Create"].Value;
  var rolesError = ViewContext.ViewData.ModelState["Input.Roles"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<section class="max-w-xl space-y-4">
  <a href="@IndexModel.Route" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Admin.Users.Title"]</a>
  <h1 class="text-2xl font-bold leading-tight">@T["Admin.Users.Create"]</h1>
  <p class="text-slate-600">@T["Admin.Users.CreateLead"]</p>

  <form method="post" class="space-y-4 rounded-xl border border-slate-200 bg-white p-4" novalidate data-testid="create-user">
    <div class="space-y-1">
      <label asp-for="Input.Email" class="label"></label>
      <input asp-for="Input.Email" type="email" inputmode="email" autocomplete="off" class="input" />
      <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div class="space-y-1">
      <label asp-for="Input.DisplayName" class="label"></label>
      <input asp-for="Input.DisplayName" autocomplete="off" class="input" />
      <span asp-validation-for="Input.DisplayName" class="field-error"></span>
    </div>
    <div class="space-y-1">
      <label asp-for="Input.PreferredLanguage" class="label"></label>
      <select asp-for="Input.PreferredLanguage" class="input">
        <option value="@Languages.Indonesian">Bahasa Indonesia</option>
        <option value="@Languages.English">English</option>
      </select>
    </div>
    <fieldset class="space-y-1">
      <legend class="label">@T["Admin.Users.Roles"]</legend>
      @foreach (var role in RoleNames.All)
      {
        <label class="flex min-h-11 items-center gap-3">
          <input type="checkbox" name="Input.Roles" value="@role" checked="@Model.Input.Roles.Contains(role)" class="size-5 rounded border-slate-300 accent-brand-600" />
          <span>@T[$"Admin.Users.RoleName.{role}"]</span>
        </label>
      }
      @if (rolesError is not null)
      {
        <span class="field-error">@rolesError</span>
      }
    </fieldset>
    <button type="submit" class="btn btn-primary w-full sm:w-auto">@T["Admin.Users.CreateSubmit"]</button>
  </form>
</section>
