@page "/admin/pengguna"
@model Akusiap.Web.Areas.Admin.Pages.Users.IndexModel
@using Akusiap.Application.Users
@using Akusiap.Domain.Users
@* User search (USR-01): a plain GET form; filters combine and paging keeps them. *@
@{
  ViewData["Title"] = T["Admin.Users.Title"].Value;
  var results = Model.Results;
}

<section class="space-y-4">
  <h1 class="text-2xl font-bold leading-tight">@T["Admin.Users.Title"]</h1>

  <form method="get" action="@IndexModel.Route" role="search" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5" data-testid="user-filters">
    <label for="users-q" class="sr-only">@T["Admin.Users.Search"]</label>
    <input id="users-q" name="q" type="search" value="@Model.Search" placeholder="@T["Admin.Users.Search"]" class="input lg:col-span-2" autocomplete="off" />
    <label for="users-role" class="sr-only">@T["Admin.Users.Role"]</label>
    <select id="users-role" name="peran" class="input">
      <option value="">@T["Admin.Users.AllRoles"]</option>
      @foreach (var role in RoleNames.All)
      {
        <option value="@role" selected="@(Model.Role == role)">@T[$"Admin.Users.RoleName.{role}"]</option>
      }
    </select>
    <label for="users-active" class="sr-only">@T["Admin.Users.Status"]</label>
    <select id="users-active" name="aktif" class="input">
      <option value="">@T["Admin.Users.AllStatuses"]</option>
      <option value="true" selected="@(Model.IsActive == true)">@T["Admin.Users.Active"]</option>
      <option value="false" selected="@(Model.IsActive == false)">@T["Admin.Access.Inactive"]</option>
    </select>
    <label for="users-sub" class="sr-only">@T["Admin.Users.Subscription"]</label>
    <select id="users-sub" name="langganan" class="input">
      @foreach (var option in Enum.GetValues<SubscriptionFilter>())
      {
        <option value="@option" selected="@(Model.Subscription == option)">@T[$"Admin.Users.Sub.{option}"]</option>
      }
    </select>
    <button type="submit" class="btn btn-secondary">@T["Catalog.Apply"]</button>
  </form>

  <p class="text-sm text-slate-500" data-testid="user-total">@T["Admin.Users.Total", results.Total]</p>

  <ul class="space-y-2" data-testid="user-list">
    @foreach (var user in results.Items)
    {
      <li>
        <a href="@IndexModel.Route/@user.Id" class="block space-y-1 rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600" data-testid="user-row" data-user-id="@user.Id">
          <span class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">@user.DisplayName</span>
            @foreach (var role in user.Roles)
            {
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">@T[$"Admin.Users.RoleName.{role}"]</span>
            }
            @if (!user.IsActive)
            {
              <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs text-red-800">@T["Admin.Access.Inactive"]</span>
            }
            @if (user.HasActiveSubscription)
            {
              <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs text-green-800">@T["Admin.Users.Subscribed"]</span>
            }
          </span>
          <span class="block break-all text-sm text-slate-600">@user.Email</span>
        </a>
      </li>
    }
  </ul>

  @if (results.PageCount > 1)
  {
    <nav aria-label="@T["Catalog.Pages"]" class="flex items-center justify-between gap-3" data-testid="user-pager">
      @if (results.Page > 1)
      {
        <a href="@Model.PageUrl(results.Page - 1)" class="btn btn-secondary">@T["Catalog.Previous"]</a>
      }
      else
      {
        <span></span>
      }
      <span class="text-sm text-slate-600">@T["Catalog.PageOf", results.Page, results.PageCount]</span>
      @if (results.Page < results.PageCount)
      {
        <a href="@Model.PageUrl(results.Page + 1)" class="btn btn-secondary">@T["Catalog.Next"]</a>
      }
      else
      {
        <span></span>
      }
    </nav>
  }
</section>
