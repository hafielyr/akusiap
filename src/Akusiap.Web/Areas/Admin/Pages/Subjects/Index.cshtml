@page "/admin/subjek"
@model Akusiap.Web.Areas.Admin.Pages.Subjects.IndexModel
@{
  ViewData["Title"] = T["Admin.Subjects.Title"].Value;
}

<section class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Admin.Subjects.Title"]</h1>
    <a href="/admin/subjek/baru" class="btn btn-primary">@T["Admin.Subjects.Add"]</a>
  </div>
  <p class="text-slate-600">@T["Admin.Subjects.Lead"]</p>

  @if (Model.Subjects.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600">@T["Admin.Subjects.Empty"]</p>
  }
  else
  {
    <ul class="space-y-2" data-testid="subject-list">
      @foreach (var subject in Model.Subjects)
      {
        <li>
          <a href="/admin/subjek/@subject.Id" class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600">
            <span class="block font-semibold">@subject.Name</span>
            @if (subject.Description is not null)
            {
              <span class="block text-sm text-slate-600">@subject.Description</span>
            }
            <span class="mt-1 block text-sm text-slate-500">
              @T["Admin.Subjects.TopicCount", subject.TopicCount] · @T["Admin.Subjects.ExamCount", subject.ExamCount]
            </span>
          </a>
        </li>
      }
    </ul>
  }
</section>
