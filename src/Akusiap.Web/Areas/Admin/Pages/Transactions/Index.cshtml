@page "/admin/transaksi"
@model Akusiap.Web.Areas.Admin.Pages.Transactions.IndexModel
@using Akusiap.Domain
@using Akusiap.Domain.Payments
@* Admin transactions (PAY-10): a plain GET form; filters combine; the CSV link carries the same filters. *@
@{
  ViewData["Title"] = T["Admin.Tx.Title"].Value;
  var results = Model.Results;
  var showFailure = Model.Status == PaymentStatus.Failed;
}

<section class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Admin.Tx.Title"]</h1>
    <a href="@Model.LinkTo(handler: "Csv")" class="btn btn-secondary" data-testid="export-csv">@T["Admin.Tx.Export"]</a>
  </div>

  <form method="get" action="@IndexModel.Route" class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6" data-testid="tx-filters">
    <input name="q" type="search" value="@Model.Who" placeholder="@T["Admin.Tx.Search"]" aria-label="@T["Admin.Tx.Search"]" class="input sm:col-span-3 lg:col-span-2" autocomplete="off" />
    <select name="Status" aria-label="@T["Admin.Tx.Status"]" class="input">
      <option value="">@T["Admin.Tx.AllStatuses"]</option>
      @foreach (var status in Enum.GetValues<PaymentStatus>())
      {
        <option value="@status" selected="@(Model.Status == status)">@T[$"Admin.Tx.Status.{status}"]</option>
      }
    </select>
    <select name="metode" aria-label="@T["Admin.Tx.Method"]" class="input">
      <option value="">@T["Admin.Tx.AllMethods"]</option>
      @foreach (var method in Enum.GetValues<PaymentMethod>())
      {
        <option value="@method" selected="@(Model.Method == method)">@T[$"Checkout.Method.{method}"]</option>
      }
    </select>
    <label class="sr-only" for="tx-from">@T["Admin.Tx.From"]</label>
    <input id="tx-from" name="dari" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="input" />
    <label class="sr-only" for="tx-to">@T["Admin.Tx.To"]</label>
    <input id="tx-to" name="sampai" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="input" />
    <button type="submit" class="btn btn-secondary sm:col-span-3 lg:col-span-6 lg:justify-self-start">@T["Catalog.Apply"]</button>
  </form>

  <p class="text-sm text-slate-500" data-testid="tx-total">@T["Admin.Tx.Total", results.Total]</p>

  <ul class="space-y-2" data-testid="tx-list">
    @foreach (var row in results.Items)
    {
      <li>
        <a href="@IndexModel.Route/@row.Id" class="block space-y-1 rounded-xl border border-slate-200 bg-white p-4 text-sm hover:border-brand-600" data-testid="tx-row" data-order="@row.OrderNumber">
          <span class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-semibold">@row.OrderNumber</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium">@T[$"Admin.Tx.Status.{row.Status}"]@(row.IsLatePayment ? " · " + T["Admin.Tx.Late"].Value : null)</span>
          </span>
          <span class="block">@row.Item · <idr value="@row.AmountIdr" /> · @T[$"Checkout.Method.{row.Method}"] @row.Channel</span>
          <span class="block break-all text-slate-600">@row.UserEmail · @JakartaTime.Format(row.CreatedAt)</span>
          @if (showFailure)
          {
            <span class="block text-red-800" data-testid="tx-failure">@(row.FailureReason ?? "-") · @T["Admin.Tx.Retries", row.RetryCount]</span>
          }
        </a>
      </li>
    }
  </ul>

  @if (results.PageCount > 1)
  {
    <nav aria-label="@T["Catalog.Pages"]" class="flex items-center justify-between gap-3">
      @if (results.Page > 1) { <a href="@Model.LinkTo(results.Page - 1)" class="btn btn-secondary">@T["Catalog.Previous"]</a> } else { <span></span> }
      <span class="text-sm text-slate-600">@T["Catalog.PageOf", results.Page, results.PageCount]</span>
      @if (results.Page < results.PageCount) { <a href="@Model.LinkTo(results.Page + 1)" class="btn btn-secondary">@T["Catalog.Next"]</a> } else { <span></span> }
    </nav>
  }
</section>
