@page "/admin/aturan"
@model Akusiap.Web.Areas.Admin.Pages.Presets.IndexModel
@{
  ViewData["Title"] = T["Admin.Presets.Title"].Value;
}

<section class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Admin.Presets.Title"]</h1>
    <a href="/admin/aturan/baru" class="btn btn-primary">@T["Admin.Presets.Add"]</a>
  </div>
  <p class="text-slate-600">@T["Admin.Presets.Lead"]</p>

  <ul class="space-y-2" data-testid="preset-list">
    @foreach (var preset in Model.Presets)
    {
      <li>
        <a href="/admin/aturan/@preset.Id" class="block space-y-1 rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600" data-testid="preset-row">
          <span class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">@preset.Name</span>
            @if (preset.IsDefault)
            {
              <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700" data-testid="default-badge">@T["Admin.Presets.Default"]</span>
            }
          </span>
          <partial name="_PresetSummaryPartial" model="preset" />
          <span class="block text-xs text-slate-500">@T["Admin.Presets.UsedBy", preset.ExamCount]</span>
        </a>
      </li>
    }
  </ul>
</section>
