@page "/admin/akses"
@model Akusiap.Web.Areas.Admin.Pages.Access.IndexModel
@using Akusiap.Application.Access
@using Akusiap.Domain.Access
@* Admin access page (ENT-03). Every form posts the user's id and redirects back to the same user. *@
@{
  ViewData["Title"] = T["Admin.Access.Title"].Value;
  var access = Model.Access;
}

<section class="max-w-xl space-y-4">
  <div class="space-y-2">
    <h1 class="text-2xl font-bold leading-tight">@T["Admin.Access.Title"]</h1>
    <p class="text-slate-600">@T["Admin.Access.Lead"]</p>
  </div>

  <form method="get" action="@IndexModel.Route" role="search" class="flex gap-2">
    <label for="access-email" class="sr-only">@T["Admin.Access.Email"]</label>
    <input id="access-email" name="email" type="email" inputmode="email" autocomplete="off" value="@Model.Email" placeholder="@T["Admin.Access.Email"]" class="input" required />
    <button type="submit" class="btn btn-secondary shrink-0">@T["Admin.Access.Find"]</button>
  </form>

  @if (Model.Errors.Count > 0)
  {
    <ul role="alert" class="space-y-1 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-testid="access-errors">
      @foreach (var error in Model.Errors)
      {
        <li>@error</li>
      }
    </ul>
  }

  @if (Model.Searched && access is null)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600" data-testid="access-no-user">@T["Admin.Access.NoUser"]</p>
  }
</section>

@if (access is not null)
{
  var user = access.User;
  <section class="max-w-xl space-y-1 rounded-xl border border-slate-200 bg-white p-4" data-testid="access-user">
    <p class="flex flex-wrap items-center gap-2 font-semibold">
      @user.DisplayName
      @if (!user.IsActive)
      {
        <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">@T["Admin.Access.Inactive"]</span>
      }
    </p>
    <p class="break-all text-sm text-slate-600">@user.Email</p>
  </section>

  <section class="max-w-xl space-y-3" aria-labelledby="purchases-heading">
    <h2 id="purchases-heading" class="text-xl font-bold">@T["Admin.Access.Purchases"]</h2>
    @if (access.Purchases.Count == 0)
    {
      <p class="text-slate-600">@T["Admin.Access.NoPurchases"]</p>
    }
    else
    {
      <ul class="space-y-3" data-testid="purchase-list">
        @foreach (var row in access.Purchases)
        {
          <li class="space-y-2 rounded-xl border border-slate-200 bg-white p-4" data-testid="purchase" data-id="@row.Id" data-state="@row.State">
            <p class="font-medium">@row.ExamTitle</p>
            <partial name="_AccessStatePartial" model="(row.State, row.EndsAt, row.DaysLeft)" />
            <p class="text-sm text-slate-500">
              @if (row.PricePaidIdr == 0)
              {
                @T["Admin.Access.Free"]
              }
              else
              {
                <idr value="@row.PricePaidIdr" />
              }
            </p>
            <partial name="_AccessActionsPartial" model="(user.Id, AccessKind.Purchase, row.Id, row.State, Model.Email)" />
          </li>
        }
      </ul>
    }
  </section>

  <section class="max-w-xl space-y-3" aria-labelledby="subscriptions-heading">
    <h2 id="subscriptions-heading" class="text-xl font-bold">@T["Admin.Access.Subscriptions"]</h2>
    @if (access.Subscriptions.Count == 0)
    {
      <p class="text-slate-600">@T["Admin.Access.NoSubscriptions"]</p>
    }
    else
    {
      <ul class="space-y-3" data-testid="subscription-list">
        @foreach (var row in access.Subscriptions)
        {
          <li class="space-y-2 rounded-xl border border-slate-200 bg-white p-4" data-testid="subscription" data-id="@row.Id" data-state="@row.State">
            <p class="font-medium">@row.PlanName</p>
            <partial name="_AccessStatePartial" model="(row.State, row.EndsAt, row.DaysLeft)" />
            <partial name="_AccessActionsPartial" model="(user.Id, AccessKind.Subscription, row.Id, row.State, Model.Email)" />
          </li>
        }
      </ul>
    }
  </section>

  <section class="max-w-xl space-y-3" aria-labelledby="grant-heading">
    <h2 id="grant-heading" class="text-xl font-bold">@T["Admin.Access.Grant"]</h2>

    <form method="post" asp-page-handler="GrantExam" class="space-y-3 rounded-xl border border-slate-200 bg-white p-4" data-testid="grant-exam">
      <input type="hidden" name="userId" value="@user.Id" />
      <input type="hidden" name="email" value="@user.Email" />
      @if (Model.Options.Exams.Count == 0)
      {
        <p class="text-slate-600">@T["Admin.Access.NoExams"]</p>
      }
      else
      {
        <div class="space-y-1">
          <label for="grant-exam" class="label">@T["Admin.Access.Exam"]</label>
          <select id="grant-exam" name="examId" class="input">
            @foreach (var exam in Model.Options.Exams)
            {
              <option value="@exam.Id">@(exam.AccessDays is { } days ? T["Admin.Access.ExamDays", exam.Title, days] : T["Admin.Access.ExamNoDays", exam.Title])</option>
            }
          </select>
        </div>
        <div class="space-y-1">
          <label for="grant-until" class="label">@T["Admin.Access.Until"]</label>
          <input id="grant-until" name="until" type="date" class="input" />
          <p class="text-sm text-slate-500">@T["Admin.Access.UntilHint"]</p>
        </div>
        <button type="submit" class="btn btn-primary w-full sm:w-auto">@T["Admin.Access.GrantExam"]</button>
      }
    </form>

    <form method="post" asp-page-handler="GrantPlan" class="space-y-3 rounded-xl border border-slate-200 bg-white p-4" data-testid="grant-plan">
      <input type="hidden" name="userId" value="@user.Id" />
      <input type="hidden" name="email" value="@user.Email" />
      <div class="space-y-1">
        <label for="grant-plan" class="label">@T["Admin.Access.Plan"]</label>
        <select id="grant-plan" name="planId" class="input">
          @foreach (var plan in Model.Options.Plans)
          {
            @if (plan.HasPrice)
            {
              <option value="@plan.Id">@plan.Name</option>
            }
            else
            {
              <option value="@plan.Id">@T["Admin.Access.PlanNoPrice", plan.Name]</option>
            }
          }
        </select>
      </div>
      <div class="space-y-1">
        <label for="grant-days" class="label">@T["Admin.Access.Days"]</label>
        <input id="grant-days" name="days" type="number" inputmode="numeric" min="1" max="@AccessGrants.MaxPlanDays" value="30" class="input" />
      </div>
      <button type="submit" class="btn btn-primary w-full sm:w-auto">@T["Admin.Access.GrantPlan"]</button>
    </form>
  </section>
}
