@page "/admin/jadwal-tes"
@model Akusiap.Web.Areas.Admin.Pages.UpcomingTests.IndexModel
@using System.Globalization
@{
  ViewData["Title"] = T["Admin.UpcomingTests.Title"].Value;
}

<section class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Admin.UpcomingTests.Title"]</h1>
    <a href="/admin/jadwal-tes/form" class="btn btn-primary" data-testid="add-test">@T["Admin.UpcomingTests.Add"]</a>
  </div>
  <p class="text-slate-600">@T["Admin.UpcomingTests.Lead"]</p>

  @if (Model.Tests.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600">@T["Admin.UpcomingTests.Empty"]</p>
  }
  else
  {
    <ul class="space-y-2" data-testid="admin-test-list">
      @foreach (var test in Model.Tests)
      {
        <li>
          <a href="/admin/jadwal-tes/form/@test.Id" class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600">
            <span class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-semibold">@test.Name</span>
              <span class="text-sm @(test.IsPublished ? "text-green-700" : "text-slate-500")">@(test.IsPublished ? T["Admin.UpcomingTests.Published"] : T["Admin.UpcomingTests.Hidden"])</span>
            </span>
            <span class="mt-1 block text-sm text-slate-600">
              @T[$"Tests.Category.{test.Category}"] · @T[$"Tests.Status.{test.ScheduleStatus}"]@if (test.KeyDate is { } date) {<text> · @date.ToString("d MMM yyyy", CultureInfo.CurrentCulture)</text>}
              @if (test.ExamTitle is not null) {<text> · @T["Admin.UpcomingTests.PackageIs", test.ExamTitle]</text>}
            </span>
          </a>
        </li>
      }
    </ul>
  }
</section>
