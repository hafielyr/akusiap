@page "/admin/ujian/{id:long}"
@model Akusiap.Web.Areas.Admin.Pages.Exams.EditModel
@using Akusiap.Domain.Content
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  ViewData["Title"] = T["Admin.Exams.EditTitle"].Value;
  var exam = Model.Exam;
  var canDelete = exam.Status != ExamStatus.Published && exam.AttemptCount == 0 && exam.PurchaseCount == 0;
}

<section class="max-w-2xl space-y-4">
  <a href="/admin/ujian" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">← @T["Admin.Exams.Title"]</a>
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold leading-tight">@exam.Title</h1>
    <partial name="_ExamStatusBadgePartial" model="exam.Status" />
  </div>
  <p class="text-sm text-slate-500" data-testid="exam-usage">
    @T["Admin.Exams.QuestionCounts", exam.QuestionCount, exam.TrialCount] · @T["Admin.Exams.Usage", exam.AttemptCount, exam.PurchaseCount]
  </p>
  <div class="space-y-3 rounded-xl border border-slate-200 bg-white p-4" data-testid="publish-section">
    <h2 class="font-semibold">@T["Admin.Publish.Title"]</h2>
    @if (exam.Status == ExamStatus.Published)
    {
      <p class="text-sm text-slate-600">@T["Admin.Publish.IsPublished"]</p>
      <form method="post" asp-page-handler="Unpublish" x-data="{ sure: false }">
        <button type="button" x-show="!sure" x-on:click="sure = true" class="btn btn-secondary">@T["Admin.Publish.Unpublish"]</button>
        <span x-show="sure" x-cloak class="block space-y-2">
          <span class="block text-sm text-amber-900">@T["Admin.Publish.UnpublishWarning"]</span>
          <span class="flex flex-wrap items-center gap-2">
            <button type="submit" class="btn bg-amber-600 text-white hover:bg-amber-700">@T["Admin.Publish.UnpublishConfirm"]</button>
            <button type="button" x-on:click="sure = false" class="btn btn-secondary">@T["Admin.Cancel"]</button>
          </span>
        </span>
      </form>
    }
    else
    {
      @if (Model.PublishProblems.Count == 0)
      {
        <p class="text-sm text-green-800" data-testid="publish-ready">@T["Admin.Publish.Ready"]</p>
      }
      else
      {
        <div class="space-y-1 rounded-lg p-3 @(Model.PublishRefused ? "bg-red-50" : "bg-amber-50")" role="@(Model.PublishRefused ? "alert" : null)" data-testid="publish-problems">
          <p class="text-sm font-medium @(Model.PublishRefused ? "text-red-800" : "text-amber-900")">@T[Model.PublishRefused ? "Admin.Publish.Refused" : "Admin.Publish.NotReady"]</p>
          <ul class="list-disc space-y-1 pl-5 text-sm @(Model.PublishRefused ? "text-red-800" : "text-amber-900")">
            @foreach (var problem in Model.PublishProblems) { <li>@problem</li> }
          </ul>
        </div>
      }
      <form method="post" asp-page-handler="Publish">
        <button type="submit" class="btn btn-primary">@T["Admin.Publish.Publish"]</button>
      </form>
    }
  </div>

  <partial name="_ExamFormPartial" model="Model.Form" />
</section>

@* Question picker (ADM-T4). htmx sends the antiforgery token from hx-headers with every request in this section. *@
<section class="max-w-2xl space-y-4 border-t border-slate-200 pt-4" aria-labelledby="exam-questions-heading"
         hx-headers="@System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string?> { ["RequestVerificationToken"] = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken })">
  <h2 id="exam-questions-heading" class="text-xl font-bold">@T["Admin.ExamQuestions.Title"]</h2>
  <partial name="_ExamQuestionsPanelPartial" model="new Akusiap.Web.Areas.Admin.Pages.Exams.ExamQuestionsPanel(Model.Questions)" />

  <div class="space-y-3 rounded-xl border border-slate-200 bg-white p-4">
    <h3 class="font-semibold">@T["Admin.ExamQuestions.AddHeading"]</h3>
    <form class="grid gap-3 sm:grid-cols-2" hx-get="/admin/ujian/@exam.Id?handler=Search" hx-target="#question-search-results"
          hx-swap="outerHTML" hx-trigger="submit, input delay:300ms, change">
      <div class="space-y-1">
        <label for="search-q" class="label">@T["Admin.Questions.Search"]</label>
        <input id="search-q" name="q" type="search" class="input" autocomplete="off" />
      </div>
      <div class="space-y-1">
        <label for="search-topic" class="label">@T["Admin.Question.Topic"]</label>
        <select id="search-topic" name="topik" class="input">
          <option value="">@T["Admin.Questions.All"]</option>
          @foreach (var group in Model.Topics.GroupBy(t => t.SubjectName))
          {
            <optgroup label="@group.Key">
              @foreach (var topic in group)
              {
                <option value="@topic.Id">@topic.Name</option>
              }
            </optgroup>
          }
        </select>
      </div>
    </form>
    <p class="text-sm text-slate-500">@T["Admin.ExamQuestions.SearchHelp"]</p>
    <partial name="_QuestionSearchResultsPartial" model="new Akusiap.Web.Areas.Admin.Pages.Exams.QuestionSearchResults(exam.Id, Model.Candidates)" />
  </div>
</section>

<section class="max-w-2xl space-y-2 border-t border-slate-200 pt-4">
  @if (canDelete)
  {
    <form method="post" asp-page-handler="Delete" x-data="{ sure: false }">
      <button type="button" x-show="!sure" x-on:click="sure = true" class="btn btn-secondary text-red-700">@T["Admin.Exams.Delete"]</button>
      <span x-show="sure" x-cloak class="flex flex-wrap items-center gap-2">
        <button type="submit" class="btn bg-red-600 text-white hover:bg-red-700">@T["Admin.ConfirmDelete"]</button>
        <button type="button" x-on:click="sure = false" class="btn btn-secondary">@T["Admin.Cancel"]</button>
      </span>
    </form>
  }
  else
  {
    <p class="text-sm text-slate-500" data-testid="delete-blocked">@T["Admin.Exams.DeleteBlocked"]</p>
  }
</section>
