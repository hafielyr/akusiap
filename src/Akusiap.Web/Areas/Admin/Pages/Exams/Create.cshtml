@page "/admin/ujian/baru"
@model Akusiap.Web.Areas.Admin.Pages.Exams.CreateModel
@{
  ViewData["Title"] = T["Admin.Exams.NewTitle"].Value;
}

<section class="max-w-2xl space-y-4">
  <a href="/admin/ujian" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">← @T["Admin.Exams.Title"]</a>
  <h1 class="text-2xl font-bold leading-tight">@T["Admin.Exams.NewTitle"]</h1>
  <p class="text-sm text-slate-500">@T["Admin.Exams.StartsAsDraft"]</p>
  <partial name="_ExamFormPartial" model="Model.Form" />
</section>
