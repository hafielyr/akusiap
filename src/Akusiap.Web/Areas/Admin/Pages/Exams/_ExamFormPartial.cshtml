@model Akusiap.Web.Areas.Admin.Pages.Exams.ExamFormView
@* Exam form. Fields post as Input.*; price and access days are hidden (and ignored by the server) for free exams. *@
@{
  var input = Model.Input;
  var modelState = ViewContext.ViewData.ModelState;
  string? ErrorFor(string field) => modelState[$"Input.{field}"]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<form method="post" class="space-y-5" novalidate x-data="{ isFree: @(input.IsFree ? "true" : "false") }">
  <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

  <div class="space-y-1">
    <label for="Input_Title" class="label">@T["Admin.Exam.Title"]</label>
    <input id="Input_Title" name="Input.Title" value="@input.Title" maxlength="200" class="input" aria-invalid="@(ErrorFor("Title") is null ? null : "true")" />
    @if (ErrorFor("Title") is { } titleError) { <span class="field-error" data-testid="error-title">@titleError</span> }
  </div>

  <div class="space-y-1">
    <label for="Input_Description" class="label">@T["Admin.Exam.Description"]</label>
    <textarea id="Input_Description" name="Input.Description" rows="3" maxlength="4000" class="input">@input.Description</textarea>
    @if (ErrorFor("Description") is { } descriptionError) { <span class="field-error">@descriptionError</span> }
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="space-y-1">
      <label for="Input_SubjectId" class="label">@T["Admin.Exam.Subject"]</label>
      <select id="Input_SubjectId" name="Input.SubjectId" class="input">
        <option value="">—</option>
        @foreach (var subject in Model.Subjects)
        {
          <option value="@subject.Id" selected="@(subject.Id == input.SubjectId)">@subject.Name</option>
        }
      </select>
      @if (ErrorFor("SubjectId") is { } subjectError) { <span class="field-error">@subjectError</span> }
    </div>

    <div class="space-y-1">
      <label for="Input_RulePresetId" class="label">@T["Admin.Exam.RulePreset"]</label>
      <select id="Input_RulePresetId" name="Input.RulePresetId" class="input">
        @foreach (var preset in Model.Presets)
        {
          <option value="@preset.Id" selected="@(preset.Id == input.RulePresetId)">@preset.Name@(preset.IsDefault ? $" ({T["Admin.Exams.DefaultPreset"].Value})" : "")</option>
        }
      </select>
      @if (ErrorFor("RulePresetId") is { } presetError) { <span class="field-error">@presetError</span> }
    </div>
  </div>

  <fieldset class="space-y-4 rounded-xl border border-slate-200 bg-white p-4">
    <legend class="label px-1">@T["Admin.Exams.Access"]</legend>
    <label class="flex min-h-11 items-center gap-3 text-slate-800">
      <input type="checkbox" name="Input.IsFree" value="true" class="size-5 accent-brand-600" checked="@input.IsFree" x-model="isFree" />
      <span>@T["Admin.Exam.IsFree"]</span>
    </label>
    <p class="text-sm text-slate-500" x-show="isFree" x-cloak>@T["Admin.Exams.FreeHelp"]</p>

    <div class="grid gap-4 sm:grid-cols-2" x-show="!isFree">
      <div class="space-y-1">
        <label for="Input_PriceIdr" class="label">@T["Admin.Exam.Price"]</label>
        <input id="Input_PriceIdr" name="Input.PriceIdr" value="@input.PriceIdr" inputmode="numeric" placeholder="Rp49.000" class="input" aria-invalid="@(ErrorFor("PriceIdr") is null ? null : "true")" />
        @if (ErrorFor("PriceIdr") is { } priceError) { <span class="field-error" data-testid="error-price">@priceError</span> }
      </div>
      <div class="space-y-1">
        <label for="Input_AccessDays" class="label">@T["Admin.Exam.AccessDays"]</label>
        <input id="Input_AccessDays" name="Input.AccessDays" value="@input.AccessDays" type="number" min="1" max="3650" inputmode="numeric" class="input" aria-invalid="@(ErrorFor("AccessDays") is null ? null : "true")" />
        @if (ErrorFor("AccessDays") is { } daysError) { <span class="field-error" data-testid="error-access-days">@daysError</span> }
      </div>
    </div>

    <div class="space-y-1">
      <label for="Input_OwnQuestionAllowance" class="label">@T["Admin.Exam.Allowance"]</label>
      <input id="Input_OwnQuestionAllowance" name="Input.OwnQuestionAllowance" value="@input.OwnQuestionAllowance" type="number" min="0" max="10000" inputmode="numeric" class="input" />
      <p class="text-sm text-slate-500">@T["Admin.Exams.AllowanceHelp"]</p>
      @if (ErrorFor("OwnQuestionAllowance") is { } allowanceError) { <span class="field-error">@allowanceError</span> }
    </div>
  </fieldset>

  <button type="submit" class="btn btn-primary w-full sm:w-auto">@T["Admin.Save"]</button>
</form>
