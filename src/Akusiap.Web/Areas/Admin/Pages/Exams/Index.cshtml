@page "/admin/ujian"
@model Akusiap.Web.Areas.Admin.Pages.Exams.IndexModel
@{
  ViewData["Title"] = T["Admin.Exams.Title"].Value;
}

<section class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Admin.Exams.Title"]</h1>
    <a href="/admin/ujian/baru" class="btn btn-primary">@T["Admin.Exams.Add"]</a>
  </div>
  <p class="text-slate-600">@T["Admin.Exams.Lead"]</p>

  @if (Model.Exams.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600">@T["Admin.Exams.Empty"]</p>
  }
  else
  {
    <ul class="space-y-2" data-testid="exam-list">
      @foreach (var exam in Model.Exams)
      {
        <li>
          <a href="/admin/ujian/@exam.Id" class="block space-y-2 rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600">
            <span class="flex items-start justify-between gap-3">
              <span class="font-semibold">@exam.Title</span>
              <partial name="_ExamStatusBadgePartial" model="exam.Status" />
            </span>
            @if (exam.SubjectName is not null)
            {
              <span class="block text-sm text-slate-500">@exam.SubjectName</span>
            }
            <span class="block text-sm text-slate-600">
              @if (exam.IsFree)
              {
                @T["Admin.Exams.FreeLabel"]
              }
              else
              {
                <idr value="@(exam.PriceIdr ?? 0)" /> @T["Admin.Exams.AccessDaysShort", exam.AccessDays ?? 0]
              }
              · @T["Admin.Exams.QuestionCounts", exam.QuestionCount, exam.TrialCount]
            </span>
          </a>
        </li>
      }
    </ul>
  }
</section>
