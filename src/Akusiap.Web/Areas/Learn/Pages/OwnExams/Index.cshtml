@page "/learn/ujian-saya"
@model Akusiap.Web.Areas.Learn.Pages.OwnExams.IndexModel
@{
  ViewData["Title"] = T["Own.Exams.Title"].Value;
  var allowance = Model.Allowance;
}

<section class="space-y-4">
  <a href="/learn" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Learn.Title"]</a>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Own.Exams.Title"]</h1>
    @if (allowance.CanCreateExam)
    {
      <a href="@IndexModel.Route/baru" class="btn btn-primary" data-testid="add-exam">@T["Own.Exams.Add"]</a>
    }
  </div>
  @if (TempData["Flash"] is string flash)
  {
    <p role="status" class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800" data-testid="flash">@T[flash]</p>
  }
  <partial name="_AllowanceBarPartial" model="allowance" />
  @if (allowance.CanEdit && !allowance.CanCreateExam)
  {
    <div class="space-y-2 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" data-testid="exam-allowance-full">
      <p>@T["Own.Exams.LimitReached", allowance.MaxExams ?? 0]</p>
      <a href="/harga" class="btn btn-primary">@T["Own.Upgrade"]</a>
    </div>
  }
  else
  {
    <partial name="_AllowanceNoticePartial" model="allowance" />
  }

  @if (Model.Exams.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600" data-testid="no-exams">@T["Own.Exams.Empty"]</p>
  }
  <ul class="space-y-2" data-testid="own-exams">
    @foreach (var exam in Model.Exams)
    {
      <li class="space-y-3 rounded-xl border border-slate-200 bg-white p-4" data-testid="own-exam" data-exam="@exam.Id">
        <div class="space-y-1">
          <p class="font-semibold">@exam.Title</p>
          <p class="text-xs text-slate-500">@T["Own.Exams.QuestionCount", exam.QuestionCount] · @T[$"Own.Exams.Status.{exam.Status}"]</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="@Akusiap.Web.Pages.Exams.ExamRoutes.Start(exam.Id)" class="btn btn-primary flex-1 sm:flex-none" data-testid="practise-own-exam">@T["Own.Exams.Practise"]</a>
          <a href="@IndexModel.Route/@exam.Id" class="btn btn-secondary flex-1 sm:flex-none">@T["Own.Exams.Edit"]</a>
        </div>
      </li>
    }
  </ul>
</section>
