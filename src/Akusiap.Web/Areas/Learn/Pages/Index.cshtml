@page "/learn"
@model Akusiap.Web.Areas.Learn.Pages.IndexModel
@* Learn area entry (SignedIn, AC-06): links to access, history, own questions, payments and the profile. *@
@{
  ViewData["Title"] = T["Learn.Title"].Value;
}

<section class="space-y-4 py-6">
  <h1 class="text-2xl font-extrabold leading-tight">@T["Learn.Title"]</h1>

  @if (Model.ResendMessage is { } message)
  {
    <p role="status" class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800" data-testid="resend-message">@T[message]</p>
  }

  @if (!Model.EmailConfirmed)
  {
    <div class="space-y-3 rounded-xl border border-amber-200 bg-amber-50 p-4" data-testid="confirm-pending">
      <p class="text-sm text-amber-900">@T["Account.Confirm.Pending"]</p>
      <form method="post" asp-page-handler="ResendConfirmation">
        <button type="submit" class="btn btn-secondary w-full sm:w-auto">@T["Account.Confirm.Resend"]</button>
      </form>
    </div>
  }

  @{
    var tiles = new (string Href, string Title, string Text, string TestId, string Tint, string Icon)[]
    {
      ("/learn/hari-ini", "Today.Title", "Today.Lead", "learn-today-link", "bg-brand-600 text-white", "M12 3v2M12 19v2M5 12H3M21 12h-2M7 7L5.5 5.5M18.5 18.5L17 17M7 17l-1.5 1.5M18.5 5.5L17 7M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"),
      ("/learn/kartu", "Flashcards.Title", "Flashcards.Link", "learn-flashcards-link", "bg-accent-50 text-accent-700", "M4 7h12v12H4zM8 7V4h12v12h-4"),
      ("/learn/riwayat", "History.Title", "History.Link", "learn-history-link", "bg-brand-50 text-brand-700", "M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"),
      ("/learn/campuran", "Mix.Title", "Mix.Link", "learn-mix-link", "bg-accent-50 text-accent-700", "M4 7h3l10 10h3M4 17h3l3-3M14 10l3-3h3M18 4l3 3-3 3M18 14l3 3-3 3"),
      ("/learn/ujian-saya", "Own.Exams.Title", "Own.Exams.Link", "learn-own-exams-link", "bg-brand-50 text-brand-700", "M5 4h14v16H5zM9 8h6M9 12h6M9 16h3"),
      ("/learn/soal-saya", "Own.Questions.Title", "Own.Questions.Link", "learn-own-questions-link", "bg-brand-50 text-brand-700", "M4 20l4-1 10-10-3-3L5 16l-1 4zM14 7l3 3"),
      ("/learn/akses", "Learn.Access.Title", "Learn.Access.Link", "learn-access-link", "bg-brand-50 text-brand-700", "M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3zM9 12l2 2 4-4"),
      ("/learn/pembayaran", "Pay.Pending.Title", "Pay.Pending.Link", "learn-payments-link", "bg-accent-50 text-accent-700", "M3 7h18v10H3zM3 10h18M7 14h3"),
      ("/learn/profil", "Profile.Title", "Profile.Link", "learn-profile-link", "bg-slate-100 text-slate-700", "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0"),
    };
  }
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
    @foreach (var tile in tiles)
    {
      <li>
        <a href="@tile.Href" class="card card-link flex h-full min-h-11 flex-col gap-2 p-4" data-testid="@tile.TestId">
          <span class="icon-tile @tile.Tint">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6"><path d="@tile.Icon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="font-bold leading-snug text-slate-900">@T[tile.Title]</span>
          <span class="text-sm text-slate-600">@T[tile.Text]</span>
        </a>
      </li>
    }
  </ul>
</section>
