@page "/learn/kelas/{id:long}/tugas/{assignmentId:long}"
@model Akusiap.Web.Areas.Learn.Pages.Classes.AssignmentModel
@using Akusiap.Domain
@* Assignment results (T-14): for the teacher, every student's attempts, first score and time, and best score; for
   everyone in the class, the class leaderboard (first Simulation attempt each). *@
@{
  var r = Model.Results;
  ViewData["Title"] = r.Assignment.ExamTitle;
  string Time(int? seconds) => seconds is { } s ? $"{s / 60}:{s % 60:00}" : "–";
  string Score(decimal? score) => score is { } s ? s.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture) + "%" : "–";
}

<section class="space-y-5">
  <a href="@ClassRoutes.Detail(Model.ClassId)" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Class.BackToClass"]</a>
  <div class="space-y-1">
    <h1 class="text-2xl font-extrabold leading-tight">@r.Assignment.ExamTitle</h1>
    <p class="text-sm text-slate-600">@JakartaTime.Format(r.Assignment.OpensAt) – @JakartaTime.Format(r.Assignment.ClosesAt) · @T[$"Class.State.{r.Assignment.State}"]</p>
  </div>

  @if (r.Students.Count > 0)
  {
    <section class="space-y-2" aria-labelledby="student-results">
      <h2 id="student-results" class="section-title">@T["Class.Results"]</h2>
      <div class="card overflow-x-auto">
        <table class="w-full text-sm" data-testid="student-results">
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
              <th class="px-3 py-2">@T["Leaderboard.Name"]</th>
              <th class="px-3 py-2 text-right">@T["Class.FirstScore"]</th>
              <th class="px-3 py-2 text-right">@T["Leaderboard.Time"]</th>
              <th class="px-3 py-2 text-right">@T["Class.BestScore"]</th>
              <th class="px-3 py-2 text-right">@T["Class.AttemptsCol"]</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var s in r.Students)
            {
              <tr class="border-b border-slate-200" data-testid="student-result" data-user="@s.UserId">
                <td class="px-3 py-2 font-semibold">@s.Name</td>
                <td class="px-3 py-2 text-right num" data-testid="first-score">@Score(s.FirstScore)@(s.Passed == true ? " ✓" : null)</td>
                <td class="px-3 py-2 text-right num">@Time(s.FirstSeconds)</td>
                <td class="px-3 py-2 text-right num">@Score(s.BestScore)</td>
                <td class="px-3 py-2 text-right num" data-testid="attempt-count">@s.Attempts</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </section>
  }

  <section class="space-y-2" aria-labelledby="class-board">
    <h2 id="class-board" class="section-title">@T["Leaderboard.Title"]</h2>
    <partial name="_LeaderboardPartial" model="r.Leaderboard" />
  </section>
</section>
