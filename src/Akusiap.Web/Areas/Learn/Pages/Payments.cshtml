@page "/learn/pembayaran"
@model Akusiap.Web.Areas.Learn.Pages.PaymentsModel
@using Akusiap.Domain
@using Akusiap.Web.Pages.Checkout
@{
  ViewData["Title"] = T["Pay.Pending.Title"].Value;
}

<section class="space-y-4">
  <a href="/learn" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Learn.Title"]</a>
  <h1 class="text-2xl font-bold leading-tight">@T["Pay.Pending.Title"]</h1>

  @if (Model.Pending.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600" data-testid="no-pending">@T["Pay.Pending.Empty"]</p>
  }
  else
  {
    <ul class="space-y-3" data-testid="pending-list">
      @foreach (var payment in Model.Pending)
      {
        <li class="space-y-2 rounded-xl border border-slate-200 bg-white p-4" data-testid="pending-payment" data-order="@payment.OrderNumber">
          <p class="font-semibold">@payment.ItemTitle</p>
          <p class="text-sm text-slate-600"><idr value="@payment.AmountIdr" /> · @payment.OrderNumber</p>
          @if (payment.ExpiresAt is { } deadline)
          {
            <p class="text-sm text-slate-600">@T["Pay.Until", JakartaTime.Format(deadline)]</p>
          }
          <a href="@PaymentRoutes.Instructions(payment.OrderNumber)" class="btn btn-secondary w-full sm:w-auto">@T["Pay.Pending.See"]</a>
        </li>
      }
    </ul>
  }
</section>
