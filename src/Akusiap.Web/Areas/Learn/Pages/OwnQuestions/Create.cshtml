@page "/learn/soal-saya/baru"
@model Akusiap.Web.Areas.Learn.Pages.OwnQuestions.CreateModel
@{
  ViewData["Title"] = T["Own.Questions.New"].Value;
}

<section class="max-w-2xl space-y-4">
  <a href="@IndexModel.Route" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Own.Questions.Title"]</a>
  <h1 class="text-2xl font-bold leading-tight">@T["Own.Questions.New"]</h1>
  <partial name="_AllowanceBarPartial" model="Model.Allowance" />
  <partial name="_AllowanceNoticePartial" model="Model.Allowance" />
  <partial name="_QuestionFormPartial" model="new Akusiap.Web.Areas.Admin.Pages.Questions.QuestionFormView(Model.Input, Model.Topics, IsNew: true)" />
</section>
