@page "/learn/soal-saya"
@model Akusiap.Web.Areas.Learn.Pages.OwnQuestions.IndexModel
@{
  ViewData["Title"] = T["Own.Questions.Title"].Value;
  var allowance = Model.Allowance;
}

<section class="space-y-4">
  <a href="/learn" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Learn.Title"]</a>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold leading-tight">@T["Own.Questions.Title"]</h1>
    @if (allowance.CanCreateQuestion)
    {
      <a href="@IndexModel.Route/baru" class="btn btn-primary" data-testid="add-question">@T["Own.Questions.Add"]</a>
    }
  </div>
  @if (TempData["Flash"] is string flash)
  {
    <p role="status" class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-800" data-testid="flash">@T[flash]</p>
  }
  <partial name="_AllowanceBarPartial" model="allowance" />
  <partial name="_AllowanceNoticePartial" model="allowance" />

  @if (Model.Questions.Count == 0)
  {
    <p class="rounded-xl border border-dashed border-slate-300 p-4 text-slate-600" data-testid="no-questions">@T["Own.Questions.Empty"]</p>
  }
  <ul class="space-y-2" data-testid="own-questions">
    @foreach (var q in Model.Questions)
    {
      <li>
        <a href="@IndexModel.Route/@q.Id" class="block space-y-1 card p-4 hover:border-brand-600" data-testid="own-question">
          <span class="line-clamp-2 block font-medium">@q.Text</span>
          <span class="block text-xs text-slate-500">@q.TopicName · @T[$"Admin.QuestionStatus.{q.Status}"]</span>
        </a>
      </li>
    }
  </ul>
</section>
