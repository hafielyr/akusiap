@model Akusiap.Application.Memorization.FlashcardSummary
@* End of a set (MEM-03): how each card was rated, and the next step. *@
<article id="flashcard" class="space-y-4 rounded-xl border border-slate-200 bg-white p-4 text-center" data-testid="flashcard-summary">
  @if ((ViewData[SetModel.NextDueKey] ?? TempData[SetModel.NextDueKey]) is string nextDue)
  {
    <p role="status" class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700" data-testid="next-due">@T["Flashcards.NextDue", nextDue]</p>
  }
  <h1 class="text-2xl font-bold leading-tight">@T["Flashcards.Done"]</h1>
  <p class="text-slate-600">@(Model.Title ?? T["Flashcards.MyCards"].Value)</p>
  <dl class="grid grid-cols-2 gap-2 text-left sm:grid-cols-4">
    @foreach (var (label, count) in new (string, int)[] { ("Forgot", Model.Forgot), ("Hard", Model.Hard), ("Good", Model.Good), ("Easy", Model.Easy) })
    {
      <div class="rounded-lg border border-slate-200 p-3">
        <dt class="text-xs text-slate-500">@T[$"Flashcards.Rating.{label}"]</dt>
        <dd class="text-xl font-bold" data-testid="summary-@label">@count</dd>
      </div>
    }
  </dl>
  <p class="text-sm text-slate-600" data-testid="summary-total">@T["Flashcards.SummaryTotal", Model.Total]</p>
  <a href="@IndexModel.Route" class="btn btn-primary w-full">@T["Flashcards.Again"]</a>
</article>
