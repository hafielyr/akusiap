@page "/learn/kartu"
@model Akusiap.Web.Areas.Learn.Pages.Flashcards.IndexModel
@* Flashcard decks (MEM-03): "Kartu saya" first, then exams with full access, each with its due count. *@
@{
  ViewData["Title"] = T["Flashcards.Title"].Value;
}

<section class="space-y-4">
  <a href="/learn" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Learn.Title"]</a>
  <div class="space-y-1">
    <h1 class="text-2xl font-bold leading-tight">@T["Flashcards.Title"]</h1>
    <p class="text-slate-600">@T["Flashcards.Lead"]</p>
  </div>
  @if (TempData["Flash"] is string flash)
  {
    <p role="status" class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" data-testid="flash">@T[flash]</p>
  }

  <ul class="space-y-3" data-testid="decks">
    @foreach (var deck in Model.Decks)
    {
      <li class="flex flex-wrap items-center justify-between gap-3 card p-4" data-testid="deck" data-exam="@(deck.ExamId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "mine")">
        <div class="min-w-0 space-y-1">
          <p class="font-semibold">@(deck.Title ?? T["Flashcards.MyCards"].Value)</p>
          <p class="text-sm text-slate-600" data-testid="deck-due">@T["Flashcards.Due", deck.DueCount]</p>
        </div>
        <form method="post" asp-page-handler="Start" class="w-full sm:w-auto">
          @if (deck.ExamId is { } examId)
          {
            <input type="hidden" name="examId" value="@examId" />
          }
          <button type="submit" class="btn btn-primary w-full" data-testid="start-deck">@T["Flashcards.Start"]</button>
        </form>
      </li>
    }
  </ul>
</section>
