@page "/learn/hari-ini"
@model Akusiap.Web.Areas.Learn.Pages.TodayModel
@* Today (SRS-03, DRL-01, PLN-01, PLN-02): each exam goal with its countdown and today's plan, the daily drill with its week strip, the level strip, and the due flashcards. Two columns on wide screens (BRD-07). *@
@{
  ViewData["Title"] = T["Today.Title"].Value;
  ViewData["Wide"] = true;
  const string startUrl = "/learn/kartu?handler=Start";
}

<section class="space-y-5">
  <div class="space-y-1">
    <h1 class="text-3xl font-bold leading-tight tracking-tight">@T["Today.Title"]</h1>
    <p class="text-slate-600">@T["Today.Lead"]</p>
  </div>
  @if (TempData["Flash"] is string flash)
  {
    <p role="status" class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" data-testid="flash">@T[flash]</p>
  }

  @{
    var drill = Model.Drill;
  }
  <div class="grid items-start gap-5 lg:grid-cols-2 lg:gap-6">
  <div class="space-y-5">
  @if (Model.Plans.Count > 0)
  {
    <section class="space-y-2" aria-labelledby="plan-title">
    <h2 id="plan-title" class="eyebrow">@T["Plan.Title"]</h2>
    <ul class="space-y-3" aria-label="@T["Goals.Countdowns"]" data-testid="goal-countdowns">
      @foreach (var plan in Model.Plans)
      {
        var goal = plan.Goal;
        var day = plan.Day;
        <li class="card space-y-4 p-4" data-testid="goal-countdown" data-exam="@goal.ExamId" data-phase="@day.Phase">
          <a href="/learn/target/@goal.Id" class="flex min-h-11 items-center gap-4" data-testid="plan-progress-link">
            <span class="min-w-16 text-3xl font-bold tabular-nums text-brand-700" data-testid="goal-countdown-days">@(goal.DaysLeft == 0 ? T["Goals.ExamToday"] : T["Goals.DaysLeft", goal.DaysLeft])</span>
            <span class="min-w-0 flex-1 space-y-0.5">
              <span class="block font-semibold">@goal.ExamTitle</span>
              <span class="block text-sm text-slate-600">@goal.ExamDate.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</span>
            </span>
          </a>
          @if (plan.PoolSize == 0)
          {
            <p class="text-sm text-slate-600" data-testid="plan-empty">@T["Plan.NoQuestions"]</p>
          }
          else
          {
            <dl class="grid grid-cols-2 gap-2">
              <div class="stat"><dt class="text-xs font-semibold text-slate-500">@T["Plan.New"]</dt><dd class="text-2xl font-bold tabular-nums text-slate-900" data-testid="plan-new">@day.NewLeftToday</dd></div>
              <div class="stat"><dt class="text-xs font-semibold text-slate-500">@T["Plan.Cards"]</dt><dd class="text-2xl font-bold tabular-nums text-slate-900" data-testid="plan-cards">@plan.DueCards</dd></div>
            </dl>
            <p class="text-sm text-slate-600" data-testid="plan-status">
              @switch (day.Phase)
              {
                case Akusiap.Domain.Planning.StudyPhase.Review:
                  @T["Plan.ReviewPhase"]
                  break;
                case Akusiap.Domain.Planning.StudyPhase.ExamDay:
                  @T["Plan.ExamDay"]
                  break;
                default:
                  @T["Plan.Progress", plan.Answered, plan.PoolSize, day.LearningDaysLeft]
                  break;
              }
            </p>
            @if (day.OverCap)
            {
              <p role="status" class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" data-testid="plan-warning">@T["Plan.OverCap", day.NewQuota, Akusiap.Domain.Planning.StudyPlanner.DailyCap]</p>
            }
            @if (plan.OpenAttemptId is { } open)
            {
              <a href="@Akusiap.Web.Pages.Sessions.SessionRoutes.Player(open)" class="btn btn-primary w-full" data-testid="plan-continue">@T["Plan.Continue"]</a>
            }
            else if (plan.TasksDoneToday)
            {
              <p class="rounded-xl bg-green-50 px-3 py-2 text-sm font-semibold text-green-800" data-testid="plan-done">@T["Plan.Done"]</p>
            }
            else
            {
              <form method="post" asp-page-handler="Plan" class="space-y-1">
                <input type="hidden" name="goalId" value="@goal.Id" />
                <button type="submit" class="btn btn-primary w-full" data-testid="plan-start">@T["Plan.Start"]</button>
                <p class="text-center text-xs text-slate-500">@T["Plan.SessionHint", Akusiap.Application.Planning.StudyPlans.SessionSize]</p>
              </form>
            }
            @if (plan.Simulation != Akusiap.Application.Planning.PlanSimulation.None)
            {
              <div class="space-y-2 border-t border-slate-200 pt-3" data-testid="plan-simulation" data-state="@plan.Simulation">
                <p class="font-semibold">@T["Plan.Simulation"]</p>
                @switch (plan.Simulation)
                {
                  case Akusiap.Application.Planning.PlanSimulation.Done:
                    <p class="rounded-xl bg-green-50 px-3 py-2 text-sm font-semibold text-green-800">@T["Plan.SimulationDone"]</p>
                    break;
                  case Akusiap.Application.Planning.PlanSimulation.InProgress:
                    <a href="@Akusiap.Web.Pages.Sessions.SessionRoutes.Player(plan.SimulationAttemptId!.Value)" class="btn btn-secondary w-full" data-testid="plan-simulation-continue">@T["Plan.SimulationContinue"]</a>
                    break;
                  default:
                    <p class="text-sm text-slate-600">@T["Plan.SimulationHint"]</p>
                    <form method="post" asp-page-handler="Simulation">
                      <input type="hidden" name="goalId" value="@goal.Id" />
                      <button type="submit" class="btn btn-secondary w-full" data-testid="plan-simulation-start">@T["Plan.SimulationStart"]</button>
                    </form>
                    break;
                }
              </div>
            }
          }
        </li>
      }
    </ul>
    </section>
  }
  else
  {
    <a href="/learn/target" class="card card-link flex items-center gap-3 p-4" data-testid="goal-set-link">
      <span class="icon-tile bg-brand-50 text-brand-700"><svg aria-hidden="true" viewBox="0 0 24 24" class="size-6"><path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      <span class="min-w-0 flex-1 space-y-0.5"><span class="block font-bold">@T["Goals.SetPrompt"]</span><span class="block text-sm text-slate-600">@T["Goals.SetPromptHint"]</span></span>
    </a>
  }
  <div class="frame rise">
  <article class="card space-y-4 p-5" data-testid="daily-drill" data-state="@drill.State">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="space-y-0.5">
        <h2 class="text-lg font-bold">@T["Drill.Title"]</h2>
        <p class="text-sm text-slate-600">@T["Drill.Lead", Akusiap.Application.Gamification.DailyDrills.Size]</p>
      </div>
      <span class="badge-soon text-sm" data-testid="drill-streak">🔥 @T["Drill.Streak", drill.Streak.Current]</span>
    </div>
    <ol class="grid grid-cols-7 gap-1 text-center" aria-label="@T["Drill.Week"]" data-testid="drill-week">
      @foreach (var (day, done) in drill.Week)
      {
        var isToday = day == drill.Week[^1].Day;
        <li class="space-y-1" data-done="@(done ? "true" : "false")">
          <span class="block text-xs text-slate-500">@day.ToString("ddd", System.Globalization.CultureInfo.CurrentCulture)</span>
          <span class="mx-auto inline-flex size-8 items-center justify-center rounded-full text-sm font-bold @(done ? "bg-accent-400 text-slate-900" : isToday ? "border-2 border-brand-600 text-brand-700" : "bg-slate-100 text-slate-500")">@(done ? "✓" : day.Day.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>
        </li>
      }
    </ol>
    @switch (drill.State)
    {
      case Akusiap.Application.Gamification.DrillState.InProgress:
        <a href="@Akusiap.Web.Pages.Sessions.SessionRoutes.Player(drill.AttemptId!.Value)" class="btn btn-primary w-full" data-testid="drill-continue">@T["Drill.Continue"]</a>
        break;
      case Akusiap.Application.Gamification.DrillState.Done:
        <p class="rounded-xl bg-green-50 px-3 py-2 text-sm font-semibold text-green-800" data-testid="drill-done">@T["Drill.Done", (drill.TodayScore ?? 0m).ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)]</p>
        <form method="post" asp-page-handler="Drill">
          <button type="submit" class="btn btn-secondary w-full" data-testid="drill-again">@T["Drill.Again"]</button>
        </form>
        break;
      default:
        <form method="post" asp-page-handler="Drill">
          <button type="submit" class="btn btn-accent w-full" data-testid="drill-start">@T["Drill.Start"]</button>
        </form>
        break;
    }
  </article>
  </div>

  <a href="/learn/perjalanan" class="card card-link flex flex-wrap items-center justify-between gap-3 p-4" data-testid="journey-strip">
    <span class="flex items-center gap-3">
      <span class="dial size-12" style="--p: @Model.Level.Percent"><span class="font-bold" data-testid="today-level">@Model.Level.Level</span></span>
      <span class="space-y-0.5"><span class="block font-bold">@T["Journey.Level", Model.Level.Level]</span><span class="block text-sm text-slate-600">@T["Journey.XpShort", Model.Level.Xp]</span></span>
    </span>
    <span class="badge-soon text-sm" data-testid="today-streak">🔥 @T["Journey.StreakShort", Model.Streak.Current]</span>
  </a>
  </div>

  <div class="space-y-5">
  <article class="panel flex flex-wrap items-center gap-4 p-5" data-testid="today-total">
    <span class="card inline-flex size-20 shrink-0 items-center justify-center rounded-full border-4 border-accent-400">
      <span class="text-3xl font-bold" data-testid="today-total-count">@Model.All.DueCount</span>
    </span>
    <div class="min-w-0 flex-1 space-y-3">
    <p class="text-lg font-bold">@T["Today.TotalDue"]</p>
    @if (Model.All.DueCount > 0)
    {
      <form method="post" action="@startUrl" asp-antiforgery="true">
        <button type="submit" class="btn btn-accent w-full sm:w-auto" data-testid="today-start-all">@T["Flashcards.Start"]</button>
      </form>
    }
    else
    {
      <p class="text-sm text-slate-600" data-testid="today-none">@T["Today.NoneDue"]</p>
    }
    </div>
  </article>

  @if (Model.Exams.Count > 0)
  {
    <ul class="space-y-2" data-testid="today-exams">
      @foreach (var deck in Model.Exams)
      {
        <li class="card flex flex-wrap items-center justify-between gap-3 p-4" data-testid="today-exam" data-exam="@deck.ExamId">
          <div class="min-w-0">
            <p class="font-semibold">@deck.Title</p>
            <p class="text-sm text-slate-600" data-testid="today-exam-due">@T["Flashcards.Due", deck.DueCount]</p>
          </div>
          <form method="post" action="@startUrl" asp-antiforgery="true" class="w-full sm:w-auto">
            <input type="hidden" name="examId" value="@deck.ExamId" />
            <button type="submit" class="btn btn-secondary w-full">@T["Flashcards.Start"]</button>
          </form>
        </li>
      }
    </ul>
  }

  <div class="flex flex-wrap gap-2">
    <a href="/ujian" class="btn btn-secondary">@T["Today.Catalog"]</a>
    <a href="/learn" class="btn btn-secondary">@T["Learn.Title"]</a>
  </div>
  </div>
  </div>
</section>
