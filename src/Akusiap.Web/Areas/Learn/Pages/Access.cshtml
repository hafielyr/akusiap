@page "/learn/akses"
@model Akusiap.Web.Areas.Learn.Pages.AccessModel
@using Akusiap.Application.Access
@using Akusiap.Web.Pages.Exams
@* My access (ENT-04): active items, then ended ones in a muted section. *@
@{
  ViewData["Title"] = T["Learn.Access.Title"].Value;
  var access = Model.Access;
}

<section class="space-y-6">
  <div class="space-y-2">
    <a href="/learn" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">&larr; @T["Learn.Title"]</a>
    <h1 class="text-2xl font-bold leading-tight">@T["Learn.Access.Title"]</h1>
    <p class="text-slate-600">@T["Learn.Access.Lead"]</p>
  </div>

  @if (access.Active.Count == 0 && access.Ended.Count == 0)
  {
    <div class="space-y-3 rounded-xl border border-dashed border-slate-300 p-4" data-testid="access-empty">
      <p class="text-slate-600">@T["Learn.Access.Empty"]</p>
      <a href="@ExamRoutes.Catalog" class="btn btn-primary w-full sm:w-auto">@T["Learn.Access.Browse"]</a>
    </div>
  }

  @if (access.Active.Count > 0)
  {
    <section class="space-y-3" aria-labelledby="active-heading">
      <h2 id="active-heading" class="text-lg font-semibold">@T["Learn.Access.Active"]</h2>
      <ul class="space-y-3" data-testid="active-list">
        @foreach (var item in access.Active)
        {
          <li class="space-y-2 rounded-xl border border-slate-200 bg-white p-4" data-testid="access-item" data-kind="@item.Kind" data-id="@item.Id">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">@(item.Kind == AccessKind.Purchase ? T["Learn.Access.Exam"] : T["Learn.Access.Plan"])</p>
            @if (item.ExamId is { } examId)
            {
              <a href="@ExamRoutes.Detail(examId)" class="block font-semibold text-slate-900 hover:text-brand-700">@item.Title</a>
            }
            else
            {
              <p class="font-semibold">@item.Title</p>
            }
            <partial name="_AccessStatePartial" model="(item.State, item.EndsAt, item.DaysLeft)" />
            @if (item.ExamId is { } startId)
            {
              <a href="@ExamRoutes.Start(startId)" class="btn btn-primary w-full sm:w-auto" data-testid="access-start">@T["ExamPage.Start"]</a>
            }
            else if (item.IncludesAllExams)
            {
              <p class="text-sm text-slate-600">@T["Learn.Access.AllExams"]</p>
              <a href="@ExamRoutes.Catalog" class="btn btn-secondary w-full sm:w-auto" data-testid="access-browse">@T["Learn.Access.Browse"]</a>
            }
          </li>
        }
      </ul>
    </section>
  }

  @if (access.Ended.Count > 0)
  {
    <section class="space-y-3 opacity-75" aria-labelledby="ended-heading">
      <h2 id="ended-heading" class="text-lg font-semibold text-slate-600">@T["Learn.Access.Ended"]</h2>
      <ul class="space-y-3" data-testid="ended-list">
        @foreach (var item in access.Ended)
        {
          <li class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4 text-slate-600" data-testid="access-item" data-kind="@item.Kind" data-id="@item.Id">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">@(item.Kind == AccessKind.Purchase ? T["Learn.Access.Exam"] : T["Learn.Access.Plan"])</p>
            <p class="font-semibold">@item.Title</p>
            <partial name="_AccessStatePartial" model="(item.State, item.EndsAt, item.DaysLeft)" />
            <a href="@(item.ExamId is { } id ? ExamRoutes.Detail(id) : ExamRoutes.Plans)" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700">@T["Learn.Access.BuyAgain"]</a>
          </li>
        }
      </ul>
    </section>
  }
</section>
