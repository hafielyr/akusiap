@page "/akun/masuk"
@model LoginModel
@{
  ViewData["Title"] = T["Account.SignIn.Title"].Value;
}

<section class="mx-auto max-w-md space-y-6">
  <h1 class="text-2xl font-bold leading-tight">@T["Account.SignIn.Heading"]</h1>

  <form method="post" class="space-y-4" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="field-error" role="alert" data-testid="sign-in-error"></div>

    <div class="space-y-1">
      <label asp-for="Input.Email" class="label"></label>
      <input asp-for="Input.Email" type="email" autocomplete="email" inputmode="email" class="input" />
      <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>

    <div class="space-y-1">
      <label asp-for="Input.Password" class="label"></label>
      <div x-data="{ show: false }" class="relative">
        <input asp-for="Input.Password" x-bind:type="show ? 'text' : 'password'" autocomplete="current-password" class="input pr-28" />
        <button type="button" x-on:click="show = !show" x-bind:aria-pressed="show.toString()"
                class="absolute inset-y-0 right-0 inline-flex min-h-11 items-center px-3 text-sm font-medium text-brand-700">
          <span x-show="!show">@T["Account.ShowPassword"]</span>
          <span x-show="show" x-cloak>@T["Account.HidePassword"]</span>
        </button>
      </div>
      <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <label class="flex min-h-11 items-center gap-3 text-slate-700">
      <input asp-for="Input.RememberMe" class="size-5 rounded border-slate-300 accent-brand-600" />
      <span>@T["Account.SignIn.RememberMe"]</span>
    </label>

    <button type="submit" class="btn btn-primary w-full">@T["Account.SignIn.Submit"]</button>
  </form>

  <p class="text-center text-sm text-slate-600">
    @T["Account.SignIn.NoAccount"]
    <a href="@AccountRoutes.WithReturnUrl(AccountRoutes.Register, Model.ReturnUrl)" class="inline-flex min-h-11 items-center font-semibold text-brand-700">@T["Nav.Register"]</a>
  </p>
</section>
