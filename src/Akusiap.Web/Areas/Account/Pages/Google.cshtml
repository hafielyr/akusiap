@page "/akun/google"
@model GoogleModel
@{
  ViewData["Title"] = T["Account.Google.Title"].Value;
}

<section class="mx-auto max-w-md space-y-6">
  <h1 class="text-2xl font-bold leading-tight">@T["Account.Google.Title"]</h1>
  <p role="alert" class="rounded-lg bg-red-50 px-3 py-2 text-red-800" data-testid="google-error">@T[Model.Error ?? "Account.Google.Failed"]</p>
  <a href="@AccountRoutes.SignIn" class="btn btn-secondary w-full">@T["Nav.SignIn"]</a>
</section>
