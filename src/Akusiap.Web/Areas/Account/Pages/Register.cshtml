@page "/akun/daftar"
@model RegisterModel
@{
  ViewData["Title"] = T["Account.Register.Title"].Value;
}

<section class="mx-auto max-w-md space-y-6">
  <div class="space-y-2">
    <h1 class="text-2xl font-bold leading-tight">@T["Account.Register.Heading"]</h1>
    <p class="text-slate-600">@T["Account.Register.Lead"]</p>
  </div>

  <form method="post" class="space-y-4" novalidate>
    <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

    <div class="space-y-1">
      <label asp-for="Input.Email" class="label"></label>
      <input asp-for="Input.Email" type="email" autocomplete="email" inputmode="email" class="input" />
      <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>

    <div class="space-y-1">
      <label asp-for="Input.DisplayName" class="label"></label>
      <input asp-for="Input.DisplayName" autocomplete="name" class="input" />
      <span asp-validation-for="Input.DisplayName" class="field-error"></span>
    </div>

    <div class="space-y-1">
      <label asp-for="Input.Password" class="label"></label>
      <div x-data="{ show: false }" class="relative">
        <input asp-for="Input.Password" x-bind:type="show ? 'text' : 'password'" autocomplete="new-password" class="input pr-28" />
        <button type="button" x-on:click="show = !show" x-bind:aria-pressed="show.toString()"
                class="absolute inset-y-0 right-0 inline-flex min-h-11 items-center px-3 text-sm font-medium text-brand-700">
          <span x-show="!show">@T["Account.ShowPassword"]</span>
          <span x-show="show" x-cloak>@T["Account.HidePassword"]</span>
        </button>
      </div>
      <p class="text-sm text-slate-500">@T["Account.PasswordHint"]</p>
      <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary w-full">@T["Account.Register.Submit"]</button>
  </form>

  <p class="text-center text-sm text-slate-600">
    @T["Account.Register.HaveAccount"]
    <a href="@AccountRoutes.SignIn" class="inline-flex min-h-11 items-center font-semibold text-brand-700">@T["Nav.SignIn"]</a>
  </p>
</section>
