@page "/akun/atur-ulang-sandi"
@model ResetPasswordModel
@{
  ViewData["Title"] = T["Account.Reset.Title"].Value;
}

<section class="card mx-auto max-w-md space-y-6 p-6 sm:p-8">
  <div class="flex justify-center"><partial name="_LogoPartial" /></div>
  <h1 class="text-2xl font-extrabold leading-tight">@T["Account.Reset.Title"]</h1>

  @if (Model.LinkInvalid)
  {
    <p role="alert" class="rounded-lg bg-red-50 px-3 py-2 text-red-800" data-testid="reset-invalid">@T["Account.Reset.Invalid"]</p>
    <a href="@AccountRoutes.ForgotPassword" class="btn btn-secondary w-full">@T["Account.Forgot.Title"]</a>
  }
  else
  {
    <form method="post" class="space-y-4" novalidate>
      <input type="hidden" asp-for="Input.Email" />
      <input type="hidden" asp-for="Input.Code" />
      <p class="break-all text-slate-600">@Model.Input.Email</p>
      <div class="space-y-1">
        <label asp-for="Input.Password" class="label"></label>
        <div x-data="{ show: false }" class="relative">
          <input asp-for="Input.Password" x-bind:type="show ? 'text' : 'password'" autocomplete="new-password" class="input pr-28" />
          <button type="button" x-on:click="show = !show" x-bind:aria-pressed="show.toString()"
                  class="absolute inset-y-0 right-0 inline-flex min-h-11 items-center px-3 text-sm font-medium text-brand-700">
            <span x-show="!show">@T["Account.ShowPassword"]</span>
            <span x-show="show" x-cloak>@T["Account.HidePassword"]</span>
          </button>
        </div>
        <p class="text-sm text-slate-500">@T["Account.PasswordHint"]</p>
        <span asp-validation-for="Input.Password" class="field-error"></span>
      </div>
      <button type="submit" class="btn btn-primary w-full">@T["Account.Reset.Submit"]</button>
    </form>
  }
</section>
