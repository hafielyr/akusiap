@* The panel beside the sign-up and sign-in forms on wide screens (BRD-08, D-115): why an account is worth it. Hidden below
   1024 px, where the form stands alone so it fits the first screen. *@
<aside class="bg-panel hidden flex-col justify-between gap-8 rounded-3xl p-8 text-white lg:flex" data-testid="auth-side">
  <div class="space-y-6">
    <div class="space-y-3">
      <p class="body-5 text-white">@T["Home.Trust.Trial"]</p>
      <p class="text-3xl font-bold leading-tight tracking-tight">@T["Account.Side.Title"]</p>
      <p class="text-white">@T["Account.Side.Lead"]</p>
    </div>
    <ul class="space-y-3">
      @foreach (var key in new[] { "Home.Feature.Cat", "Home.Feature.Explanations", "Home.Feature.Flashcards", "Home.Feature.Drills" })
      {
        <li class="flex items-start gap-3">
          <span class="mt-0.5 inline-grid size-6 shrink-0 place-items-center rounded-full bg-white/20 text-sm font-bold" aria-hidden="true">✓</span>
          <span class="font-semibold">@T[key]</span>
        </li>
      }
    </ul>
  </div>
  <p class="text-sm text-white">@T["Home.Trust.Phone"] · @T["Home.Trust.Explanations"]</p>
</aside>
