@page "/akun/lupa-sandi"
@model ForgotPasswordModel
@{
  ViewData["Title"] = T["Account.Forgot.Title"].Value;
}

<div class="frame rise mx-auto max-w-md sm:mt-6">
<section class="card space-y-6 p-6 sm:p-8">
  <div class="flex justify-center"><partial name="_LogoPartial" /></div>
  <div class="space-y-2">
    <h1 class="text-2xl font-extrabold leading-tight">@T["Account.Forgot.Title"]</h1>
    <p class="text-slate-600">@T["Account.Forgot.Lead"]</p>
  </div>

  @if (Model.Sent)
  {
    <p role="status" class="rounded-lg bg-green-50 px-3 py-2 text-green-800" data-testid="forgot-sent">@T["Account.Forgot.Sent"]</p>
  }
  else
  {
    <form method="post" class="space-y-4" novalidate>
      <div class="space-y-1">
        <label asp-for="Input.Email" class="label"></label>
        <input asp-for="Input.Email" type="email" autocomplete="email" inputmode="email" class="input" />
        <span asp-validation-for="Input.Email" class="field-error"></span>
      </div>
      <button type="submit" class="btn btn-primary w-full">@T["Account.Forgot.Submit"]</button>
    </form>
  }

  <p class="text-center text-sm">
    <a href="@AccountRoutes.SignIn" class="inline-flex min-h-11 items-center font-semibold text-brand-700">@T["Nav.SignIn"]</a>
  </p>
</section>
</div>
